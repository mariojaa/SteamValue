<!-- Connection Status Indicator -->
<div id="connectionStatus" class="connection-status status-disconnected">
    <span class="status-dot dot-disconnected" id="statusDot"></span>
    <span id="statusText">Desconectado</span>
</div>

<script>
// ── Configuration ──
const RECONNECT_INTERVAL = 3000;
const MAX_RECONNECT_ATTEMPTS = 5;

// ── State ─-
let connection = null;
let allGames = [];
let inventories = {};
let activeInvTab = null;
let activeInventoryAppId = null;
let histChart = null;
let snapshotData = [];
let totalGamesValue = 0, totalInvValue = 0;
let totalGamesCount = 0, totalInvCount = 0, totalPlaytime = 0;
let rarityChart = null;
let countriesChart = null;
let activeRarityFilter = '';
const POPULAR_APPS = [730, 570, 440, 252490, 578080, 1172470, 304930, 1091500, 271590, 892970];
const INVENTORY_SUPPORTED_APPS = {730:'CS2',570:'Dota 2',440:'TF2',252490:'Rust',1172470:'Apex Legends',578080:'PUBG',304930:'Unturned'};
let _lazyPricingActive = false;
let _lazyPricingQueue = [];
let _trackerCharts = {};
let _watchlistPriceWait = new Set();

// ── Connection Management ──
function updateConnectionStatus(state) {
    const statusDiv = document.getElementById('connectionStatus');
    const dot = document.getElementById('statusDot');
    const text = document.getElementById('statusText');

    statusDiv.className = 'connection-status';
    dot.className = 'status-dot';

    switch(state) {
        case 'connected':
            statusDiv.classList.add('status-connected');
            dot.classList.add('dot-connected');
            text.textContent = 'Conectado';
            break;
        case 'connecting':
            statusDiv.classList.add('status-connecting');
            dot.classList.add('dot-connecting');
            text.textContent = 'Conectando...';
            break;
        default:
            statusDiv.classList.add('status-disconnected');
            dot.classList.add('dot-disconnected');
            text.textContent = 'Desconectado';
    }
}

function buildConnection() {
    if (connection && connection.state === signalR.HubConnectionState.Connected) {
        return Promise.resolve(connection);
    }

    updateConnectionStatus('connecting');

    connection = new signalR.HubConnectionBuilder()
        .withUrl('/calculationHub')
        .withAutomaticReconnect([0, 2000, 5000, 10000, 20000])
        .configureLogging(signalR.LogLevel.Information)
        .build();

    // Connection event handlers
    connection.onreconnecting(error => {
        console.log('Reconnecting due to error:', error);
        updateConnectionStatus('connecting');
        showError('Conexão perdida. Tentando reconectar...');
    });

    connection.onreconnected(connectionId => {
        console.log('Reconnected successfully');
        updateConnectionStatus('connected');
        hideError();
    });

    connection.onclose(error => {
        console.log('Connection closed:', error);
        updateConnectionStatus('disconnected');
        showError('Conexão com o servidor perdida. Recarregue a página.');
    });

    // ── SignalR Handlers ──
    connection.on('UpdateProgress', (pct, msg) => {
        document.getElementById('progressWrap').classList.add('active');
        document.getElementById('progressBar').style.width = pct + '%';
        document.getElementById('progressPct').textContent = pct + '%';
        document.getElementById('progressMsg').textContent = msg;
    });

    connection.on('ReceiveProfileInfo', (info) => {
        document.getElementById('progressWrap').classList.remove('active');
        renderProfileInfo(info);
    });

    connection.on('ReceiveGamesData', (games, total) => {
        allGames = games || [];
        totalGamesValue = total || 0;
        totalGamesCount = allGames.length;
        totalPlaytime = allGames.reduce((s, g) => s + (g.playtimeMinutes || 0), 0);
        showFeaturePanel('games');
        applyGamesFilter();
        updateStats();
        resetBtn();
        populateInvGamePickers();
    });

    connection.on('ReceiveInventoryData', (gameName, rawItems, total) => {
        if (!rawItems || rawItems.length === 0) return;
        const hasPrices = rawItems.some(it => it.price >= 0);
        const items = rawItems.map(it => ({
            ...it,
            price: it.price < 0 ? null : it.price,
            unitPrice: it.unitPrice < 0 ? null : it.unitPrice
        }));
        
        if (inventories[gameName]) {
            inventories[gameName].items = items;
            inventories[gameName].total = total;
            inventories[gameName].hasRealPrices = hasPrices;
        } else {
            inventories[gameName] = { 
                items, 
                total, 
                hasRealPrices: hasPrices, 
                appId: activeInventoryAppId 
            };
            totalInvCount += items.length;
        }
        
        if (hasPrices) totalInvValue = Object.values(inventories).reduce((s, inv) => s + (inv.total || 0), 0);
        
        document.getElementById('invLoadingGame').style.display = 'none';
        document.getElementById('invGameLoadingMsg').style.display = 'none';
        document.getElementById('progressWrap').classList.remove('active');
        renderInvTabs();
        updateStats();
        showFeaturePanel('inventory');
        document.getElementById('invEmpty').classList.add('hidden');
        document.getElementById('invBadge').textContent = totalInvCount + ' itens';
        
        if (activeInventoryAppId === 730) {
            document.getElementById('cs2WearFilters').style.display = '';
        }
        renderRarityChart();
    });

    connection.on('ReceiveQuickInventory', (gameName, appId, items) => {
        if (!items || items.length === 0) return;
        const mapped = items.map(it => ({...it, price: null, unitPrice: null, appId}));
        inventories[gameName] = { items: mapped, total: 0, hasRealPrices: false, appId };
        totalInvCount += items.length;
        
        document.getElementById('invLoadingGame').style.display = 'none';
        document.getElementById('invGameLoadingMsg').style.display = 'none';
        renderInvTabs();
        showFeaturePanel('inventory');
        document.getElementById('invEmpty').classList.add('hidden');
        document.getElementById('invBadge').textContent = totalInvCount + ' itens';
        
        if (appId === 730) {
            document.getElementById('cs2WearFilters').style.display = '';
        }
        renderRarityChart();
    });

    connection.on('ReceiveQuickInventoryDone', (total) => {
        document.getElementById('progressWrap').classList.remove('active');
        if (total === 0) {
            document.getElementById('invEmpty').classList.remove('hidden');
            return;
        }
        document.getElementById('priceQueueInfo').style.display = '';
        document.getElementById('priceQueueInfo').textContent = `⚡ ${total} itens carregados em segundos! Clique em "💰 Precificar itens" para buscar valores (~3.5s por item único).`;
        document.getElementById('btnPriceAllItems').style.display = '';
        document.getElementById('invBadge').textContent = total + ' itens';
        updateStats();
    });

    connection.on('ReceiveItemPrice', (marketHashName, appId, price) => {
        handleWatchlistPrice(marketHashName, appId, price);

        let updated = false;
        for (const [gameName, inv] of Object.entries(inventories)) {
            if (inv.hasRealPrices) continue;
            const item = inv.items.find(it => it.name === marketHashName && it.appId === appId);
            if (item) {
                item.unitPrice = price;
                item.price = price * item.count;
                if (!inv.hasRealPrices) inv.total = (inv.total || 0) + item.price;
                updated = true;
            }
        }
        if (updated) {
            renderInvGrid();
            renderRarityChart();
            totalInvValue = Object.values(inventories).reduce((s, inv) => s + (inv.total || 0), 0);
            updateStats();
        }
    });

    connection.on('ReceiveItemPriceUpdate', (gameName, appId, itemName, unitPrice, count) => {
        handleWatchlistPrice(itemName, appId, unitPrice);
        const inv = inventories[gameName];
        if (!inv) return;
        const item = inv.items.find(it => it.name === itemName);
        if (item) {
            item.unitPrice = unitPrice;
            item.price = unitPrice * count;
        }
        inv.total = inv.items.reduce((s, it) => s + (it.price > 0 ? it.price : 0), 0);
        inv.hasRealPrices = true;
        
        if (activeInvTab === gameName) renderInvGrid();
        totalInvValue = Object.values(inventories).reduce((s, iv) => s + (iv.total || 0), 0);
        updateStats();
    });

    connection.on('ReceiveInventoryGameTotal', (gameName, gameTotal) => {
        if (inventories[gameName]) {
            inventories[gameName].total = gameTotal;
            inventories[gameName].hasRealPrices = true;
        }
        totalInvValue = Object.values(inventories).reduce((s, iv) => s + (iv.total || 0), 0);
        renderInvTabs();
        updateStats();
        renderRarityChart();
    });

    connection.on('ReceiveInventoryTotal', (total) => {
        totalInvValue = total;
        updateStats();
        if (Object.keys(inventories).length === 0) {
            document.getElementById('invEmpty').classList.remove('hidden');
        }
    });

    connection.on('ReceiveTotalValue', (total) => {
        document.getElementById('totalBox').classList.remove('hidden');
        document.getElementById('totalVal').textContent = fmtBRL(total);
        snapshotData.push({ time: new Date().toLocaleTimeString('pt-BR'), total });
        updateHistChart();
        resetBtn();
    });

    connection.on('ReceiveWishlist', (items) => {
        document.getElementById('progressWrap').classList.remove('active');
        renderWishlist(items);
        showFeaturePanel('wishlist');
    });

    connection.on('ReceiveBadges', (data) => {
        document.getElementById('progressWrap').classList.remove('active');
        renderBadges(data);
    });

    connection.on('ReceiveBadgesAndLevel', (data) => {
        document.getElementById('progressWrap').classList.remove('active');
        renderBadgesDetailed(data);
        showFeaturePanel('badges');
    });

    connection.on('ReceivePlaytimeAnalytics', (data) => {
        document.getElementById('progressWrap').classList.remove('active');
        renderPlaytimeAnalytics(data);
        showFeaturePanel('playtime');
    });

    connection.on('ReceiveProfileComparison', (data) => {
        document.getElementById('progressWrap').classList.remove('active');
        renderComparison(data);
        showFeaturePanel('compare');
    });

    connection.on('ReceiveLivePlayerCounts', (results) => {
        document.getElementById('progressWrap').classList.remove('active');
        renderLivePlayers(results);
        showFeaturePanel('liveplayers');
    });

    connection.on('ReceiveAchievements', (appId, total, unlocked, pct, list) => {
        document.getElementById('progressWrap').classList.remove('active');
        renderAchievements(appId, total, unlocked, pct, list || []);
    });

    connection.on('ReceiveSnapshots', (snaps) => {
        document.getElementById('progressWrap').classList.remove('active');
        if (!snaps || snaps.length === 0) return;
        snapshotData = snaps.map(s => ({ time: s.time, total: s.total }));
        updateHistChart();
        showFeaturePanel('history');
    });

    connection.on('ReceivePlaytimeROI', (data) => {
        document.getElementById('progressWrap').classList.remove('active');
        renderROI(data || []);
        showFeaturePanel('roi');
    });

    connection.on('ReceiveGameScout', (data) => {
        document.getElementById('progressWrap').classList.remove('active');
        renderGameScout(data || []);
        showFeaturePanel('scout');
    });

    connection.on('ReceiveFriendLeaderboard', (data) => {
        document.getElementById('progressWrap').classList.remove('active');
        renderLeaderboard(data || []);
        showFeaturePanel('leaderboard');
    });

    connection.on('ReceiveTradeTracker', (data) => {
        document.getElementById('progressWrap').classList.remove('active');
        renderTradeTracker(data || []);
        showFeaturePanel('tradetracker');
    });

    connection.on('ReceiveFriendCountries', (data) => {
        document.getElementById('progressWrap').classList.remove('active');
        renderCountries(data || []);
        showFeaturePanel('countries');
    });

    connection.on('ReceiveGamerDna', (data) => {
        document.getElementById('progressWrap').classList.remove('active');
        renderGamerDna(data);
        showFeaturePanel('gamerdna');
    });

    connection.on('ReceiveFriendActivityPatterns', (data) => {
        document.getElementById('progressWrap').classList.remove('active');
        renderActivityPatterns(data || []);
        showFeaturePanel('activitypatterns');
    });

    connection.on('ReceiveWishlistAnalysis', (data) => {
        document.getElementById('progressWrap').classList.remove('active');
        renderWishlistAnalysis(data);
        showFeaturePanel('wishlistanalysis');
    });

    connection.on('ReceiveFreeGamesToday', (data) => {
        document.getElementById('progressWrap').classList.remove('active');
        renderFreeGames(data || []);
        showFeaturePanel('freegames');
    });

    connection.on('ReceiveGameNews', (data) => {
        document.getElementById('progressWrap').classList.remove('active');
        renderGameNews(data || []);
        showFeaturePanel('gamenews');
    });

    connection.on('ReceiveBacklogAnalysis', (data) => {
        document.getElementById('progressWrap').classList.remove('active');
        renderBacklogAnalysis(data);
        showFeaturePanel('backlog');
    });

    connection.on('ReceiveTopRatedUnowned', (data) => {
        document.getElementById('progressWrap').classList.remove('active');
        renderTopRatedUnowned(data || []);
        showFeaturePanel('toprated');
    });

    connection.on('ReceiveError', (msg) => {
        showError(msg);
        resetBtn();
        document.getElementById('progressWrap').classList.remove('active');
    });

    return connection.start()
        .then(() => {
            console.log('SignalR connected successfully');
            updateConnectionStatus('connected');
            hideError();
            // Pre-load live players
            connection.invoke('GetLivePlayerCounts', POPULAR_APPS).catch(console.error);
        })
        .catch(err => {
            console.error('SignalR connection error:', err);
            updateConnectionStatus('disconnected');
            showError('Erro ao conectar com o servidor. Recarregue a página.');
            return Promise.reject(err);
        });
}

function hideError() {
    const errorBox = document.getElementById('errorBox');
    if (errorBox) errorBox.innerHTML = '';
}

function showProgress(msg) {
    document.getElementById('progressWrap').classList.add('active');
    document.getElementById('progressBar').style.width = '5%';
    document.getElementById('progressPct').textContent = '...';
    document.getElementById('progressMsg').textContent = msg;
}

// ── Initialize connection on page load ──
document.addEventListener('DOMContentLoaded', () => {
    buildConnection().catch(() => {
        // Try again after 5 seconds
        setTimeout(buildConnection, 5000);
    });

    try {
        const savedUrl = localStorage.getItem('steamProfileUrl');
        if (savedUrl) document.getElementById('profileUrl').value = savedUrl;
    } catch {}
    
    renderWatchlistItems();
});


// ── Feature tabs navigation ──
document.querySelectorAll('.ftab').forEach(tab => {
    tab.addEventListener('click', () => {
        document.querySelectorAll('.ftab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.ftab-panel').forEach(p => p.classList.remove('active'));
        tab.classList.add('active');
        document.getElementById('tab-' + tab.dataset.tab).classList.add('active');
        
        if (tab.dataset.tab === 'watchlist') {
            renderWatchlistItems();
        }
    });
});

function showFeaturePanel(tab) {
    document.getElementById('featurePanel').classList.remove('hidden');
    document.querySelectorAll('.ftab').forEach(t => {
        t.classList.toggle('active', t.dataset.tab === tab);
    });
    document.querySelectorAll('.ftab-panel').forEach(p => p.classList.remove('active'));
    const el = document.getElementById('tab-' + tab);
    if (el) el.classList.add('active');
}

