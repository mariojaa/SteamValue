// ── Core Functions ──
function getUrl() {
    const url = document.getElementById('profileUrl').value.trim();
    if (!url) { showError('Insira a URL do perfil Steam'); return null; }
    return url;
}

function ensureConnected(fn) {
    if (connection && connection.state === signalR.HubConnectionState.Connected) {
        fn();
    } else {
        showError('Aguardando conexão com o servidor...');
        buildConnection().then(fn).catch(() => {
            showError('Não foi possível conectar ao servidor. Recarregue a página.');
        });
    }
}

function showLoading(containerId, msg) {
    const el = document.getElementById(containerId);
    if (el) el.innerHTML = `<div style="display:flex;align-items:center;gap:12px;padding:28px 14px;color:var(--text2);font-style:italic">
        <div style="width:20px;height:20px;border:2px solid rgba(0,229,255,.3);border-top-color:var(--cyan);border-radius:50%;animation:spin .7s linear infinite;flex-shrink:0"></div>
        ${msg}
    </div>`;
}

function startCalculation() {
    const url = getUrl();
    if (!url) return;
    const calcGames = document.getElementById('calcGames').checked;

    allGames = []; inventories = {};
    totalGamesValue = 0; totalInvValue = 0;
    totalGamesCount = 0; totalInvCount = 0; totalPlaytime = 0;

    document.getElementById('featurePanel').classList.add('hidden');
    document.getElementById('totalBox').classList.add('hidden');
    document.getElementById('statsGrid').classList.add('hidden');
    document.getElementById('profilePanel').classList.remove('visible');
    document.getElementById('errorBox').innerHTML = '';
    document.getElementById('gamesGrid').innerHTML = '';
    document.getElementById('invGrid').innerHTML = '';
    document.getElementById('invTabs').innerHTML = '';
    document.getElementById('invGameSelectorWrap').style.display = 'none';
    document.getElementById('invRarityChart').style.display = 'none';

    document.getElementById('btnSpinner').classList.remove('hidden');
    document.getElementById('btnText').textContent = 'Calculando';
    document.getElementById('btnCalc').disabled = true;
    document.getElementById('progressWrap').classList.add('active');
    document.getElementById('progressBar').style.width = '2%';
    document.getElementById('progressPct').textContent = '...';
    document.getElementById('progressMsg').textContent = 'Iniciando cálculo...';

    try { localStorage.setItem('steamProfileUrl', url); } catch {}

    ensureConnected(() =>
        connection.invoke('StartCalculation', url, calcGames, false)
            .catch(e => { showError(e.message); resetBtn(); })
    );
}

function resetBtn() {
    document.getElementById('btnSpinner').classList.add('hidden');
    document.getElementById('btnText').textContent = 'Calcular';
    document.getElementById('btnCalc').disabled = false;
    document.getElementById('progressWrap').classList.remove('active');
}

// ── Profile ──
function renderProfileInfo(info) {
    if (!info) return;
    const panel = document.getElementById('profilePanel');
    panel.classList.add('visible');

    document.getElementById('pAvatar').src = info.avatar || '';
    document.getElementById('pName').textContent = info.name || 'Perfil';

    const states = ['Offline','Online','Ocupado','Ausente','Cochilando','Quer jogar','Quer conversar'];
    const stateColors = ['var(--offline)','var(--online)','var(--green)','var(--gold)','#60a5fa','#a78bfa','#f472b6'];
    const s = info.personastate || 0;
    document.getElementById('pStatus').innerHTML =
        `<span style="width:8px;height:8px;border-radius:50%;background:${stateColors[s]||'var(--offline)'};display:inline-block;margin-right:6px"></span>${states[s]||'Offline'}${info.country ? ' · '+info.country : ''}`;

    const link = document.getElementById('pSteamLink');
    if (info.profileUrl) link.href = info.profileUrl;

    const chips = document.getElementById('pChips');
    chips.innerHTML = '';
    if (info.level > 0) chips.innerHTML += `<span class="chip chip-cyan">Nível ${info.level}</span>`;
    if (info.created) chips.innerHTML += `<span class="chip">Desde ${new Date(info.created*1000).getFullYear()}</span>`;
    if (info.badgeCount > 0) chips.innerHTML += `<span class="chip chip-gold">🏅 ${info.badgeCount} badges</span>`;
    if (info.bans) {
        if (info.bans.VacBanned) chips.innerHTML += `<span class="chip chip-red">⚠ VAC BAN (${info.bans.NumberOfVacBans}x, ${info.bans.DaysSinceLastBan}d)</span>`;
        else chips.innerHTML += `<span class="chip chip-green">✓ Sem bans</span>`;
        if (info.bans.NumberOfGameBans > 0) chips.innerHTML += `<span class="chip chip-red">⚠ Game Ban ${info.bans.NumberOfGameBans}x</span>`;
    }

    const rg = document.getElementById('pRecentGames');
    rg.innerHTML = '';
    if (info.recentGames && info.recentGames.length > 0) {
        rg.innerHTML = '<div style="font-size:.7rem;color:var(--text3);text-transform:uppercase;letter-spacing:1px;margin-right:4px;align-self:center">Jogados:</div>';
        info.recentGames.forEach(g => {
            rg.innerHTML += `<div class="mini-game">
                <img src="${g.imageUrl||''}" onerror="this.src='https://cdn.akamai.steamstatic.com/steam/apps/${g.appId}/header.jpg'">
                <div class="mini-info">
                    <div class="mini-name" title="${g.name}">${g.name}</div>
                    <div class="mini-time">${Math.round((g.playtime2weeks||0)/60)}h (2sem)</div>
                </div>
            </div>`;
        });
    }
}

// ── Stats ──
function updateStats() {
    document.getElementById('statsGrid').classList.remove('hidden');
    document.getElementById('statGamesCount').textContent = totalGamesCount.toLocaleString('pt-BR');
    document.getElementById('statGamesVal').textContent = fmtBRL(totalGamesValue);
    document.getElementById('statInvCount').textContent = totalInvCount.toLocaleString('pt-BR');
    document.getElementById('statInvVal').textContent = fmtBRL(totalInvValue);
    document.getElementById('statPlaytime').textContent = Math.round(totalPlaytime/60).toLocaleString('pt-BR') + 'h';
}

// ── Games ──
function applyGamesFilter() {
    const maxVal = parseFloat(document.getElementById('filterMaxVal').value) || Infinity;
    const sort = document.getElementById('sortGames').value;
    const search = (document.getElementById('filterSearch').value || '').toLowerCase();

    let list = [...allGames]
        .filter(g => g.price <= maxVal || !isFinite(maxVal))
        .filter(g => !search || (g.name||'').toLowerCase().includes(search));

    if (sort === 'price_desc') list.sort((a,b) => b.price - a.price);
    else if (sort === 'price_asc') list.sort((a,b) => a.price - b.price);
    else if (sort === 'playtime_desc') list.sort((a,b) => b.playtimeMinutes - a.playtimeMinutes);
    else if (sort === 'metacritic_desc') list.sort((a,b) => (b.metacritic||0) - (a.metacritic||0));
    else list.sort((a,b) => (a.name||'').localeCompare(b.name||''));

    document.getElementById('gamesBadge').textContent = list.length + ' jogos';
    const grid = document.getElementById('gamesGrid');
    if (!list.length) { grid.innerHTML = '<p style="color:var(--text3);padding:18px">Nenhum jogo encontrado.</p>'; return; }
    grid.innerHTML = list.map(g => {
        let mcBadge = '';
        if (g.metacritic > 0) {
            const cls = g.metacritic >= 75 ? 'mc-good' : g.metacritic >= 50 ? 'mc-ok' : 'mc-bad';
            mcBadge = `<span class="metacritic-badge ${cls}">${g.metacritic}</span>`;
        }
        return `<div class="game-card" onclick="window.open('https://store.steampowered.com/app/${g.appId}','_blank')">
            <img src="${g.imageUrl||''}" alt="${g.name}" onerror="this.src='https://cdn.akamai.steamstatic.com/steam/apps/${g.appId}/header.jpg'">
            <div class="game-card-info">
                <div class="game-name" title="${g.name}">${g.name}</div>
                <div class="game-price">${g.price > 0 ? fmtBRL(g.price) : 'Grátis'}</div>
                <div class="game-playtime">${fmtTime(g.playtimeMinutes)}</div>
                <div class="game-meta">${mcBadge}${g.genre||''}</div>
            </div>
        </div>`;
    }).join('');
}

// ── Inventory ──
function populateInvGamePickers() {
    const supported = allGames.filter(g => INVENTORY_SUPPORTED_APPS[g.appId]);
    const pickerList = document.getElementById('invGamePickerList');
    const selectorWrap = document.getElementById('invGameSelectorWrap');
    const games = supported.length ? supported : Object.entries(INVENTORY_SUPPORTED_APPS).map(([id,name]) => ({appId:parseInt(id),name}));
    renderInvGameButtons(games, pickerList);
    renderInvGameButtons(games, document.getElementById('invGameList'));
    selectorWrap.style.display = '';
}

function renderInvGameButtons(games, container) {
    if (!container) return;
    const gameImgMap = {730:'https://cdn.akamai.steamstatic.com/steam/apps/730/capsule_sm_120.jpg',570:'https://cdn.akamai.steamstatic.com/steam/apps/570/capsule_sm_120.jpg',440:'https://cdn.akamai.steamstatic.com/steam/apps/440/capsule_sm_120.jpg',252490:'https://cdn.akamai.steamstatic.com/steam/apps/252490/capsule_sm_120.jpg',1172470:'https://cdn.akamai.steamstatic.com/steam/apps/1172470/capsule_sm_120.jpg',578080:'https://cdn.akamai.steamstatic.com/steam/apps/578080/capsule_sm_120.jpg',304930:'https://cdn.akamai.steamstatic.com/steam/apps/304930/capsule_sm_120.jpg'};
    container.innerHTML = games.map(g => {
        const name = INVENTORY_SUPPORTED_APPS[g.appId] || g.name;
        return `<button class="btn btn-ghost btn-sm inv-game-pick-btn" data-appid="${g.appId}"
                    onclick="loadInventoryForGame(${g.appId},'${name.replace(/'/g,"\\'")}')"
                    style="display:flex;align-items:center;gap:6px;padding:7px 12px;">
            <img src="${gameImgMap[g.appId]||''}" style="width:28px;height:16px;border-radius:3px;object-fit:cover" onerror="this.style.display='none'">
            ${name}
        </button>`;
    }).join('');
}

function loadInventoryForGame(appId, gameName) {
    const url = document.getElementById('profileUrl').value.trim();
    if (!url) { showError('Insira a URL do perfil Steam'); return; }

    activeInventoryAppId = appId;
    document.querySelectorAll('.inv-game-pick-btn').forEach(b => b.classList.toggle('active', parseInt(b.dataset.appid) === appId));
    document.getElementById('cs2WearFilters').style.display = appId === 730 ? '' : 'none';

    const gameKey = INVENTORY_SUPPORTED_APPS[appId] || gameName;
    delete inventories[gameKey];
    totalInvCount = Object.values(inventories).reduce((s,inv) => s + inv.items.length, 0);
    totalInvValue = 0;

    document.getElementById('invEmpty').classList.add('hidden');
    document.getElementById('invGrid').innerHTML = '';
    document.getElementById('invRarityChart').style.display = 'none';
    document.getElementById('invLoadingGame').style.display = '';
    document.getElementById('invLoadingGame').textContent = `⏳ Buscando inventário: ${gameName}...`;
    document.getElementById('invGameLoadingMsg').style.display = '';
    document.getElementById('invGameLoadingMsg').textContent = `⏳ Buscando inventário: ${gameName}...`;

    showFeaturePanel('inventory');
    document.getElementById('progressWrap').classList.add('active');
    document.getElementById('progressBar').style.width = '5%';
    document.getElementById('progressPct').textContent = '...';
    document.getElementById('progressMsg').textContent = `Buscando inventário ${gameName}...`;

    ensureConnected(() =>
        connection.invoke('GetSingleGameInventory', url, appId)
            .catch(e => {
                showError(e.message);
                document.getElementById('invLoadingGame').style.display = 'none';
                document.getElementById('invGameLoadingMsg').style.display = 'none';
                document.getElementById('progressWrap').classList.remove('active');
            })
    );
}

function toggleAllWear() {
    const ids = ['wearFN','wearMW','wearFT','wearWW','wearBS'];
    const anyUnchecked = ids.some(id => !document.getElementById(id).checked);
    ids.forEach(id => document.getElementById(id).checked = anyUnchecked);
    renderInvGrid();
}

['wearFN','wearMW','wearFT','wearWW','wearBS'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.addEventListener('change', renderInvGrid);
});

function renderInvTabs() {
    const tabs = document.getElementById('invTabs');
    const names = Object.keys(inventories);
    if (!activeInvTab || !inventories[activeInvTab]) activeInvTab = names[0] || null;
    tabs.innerHTML = names.map(name => {
        const inv = inventories[name];
        const priceLabel = inv.hasRealPrices ? fmtBRL(inv.total) : `${inv.items.length} itens`;
        return `<button class="inv-tab ${name===activeInvTab?'active':''}" onclick="setInvTab('${name}')">${name} (${inv.items.length}) ${priceLabel}</button>`;
    }).join('');
    if (names.length > 0) {
        document.getElementById('invFilterRow').style.display = 'flex';
        updateRarityFilterOptions();
    }
    renderInvGrid();
}

function setInvTab(name) {
    activeInvTab = name;
    activeRarityFilter = '';
    document.getElementById('cs2WearFilters').style.display = name === 730 ? '' : 'none';
    renderInvTabs();
    renderRarityChart();
}

function updateRarityFilterOptions() {
    const sel = document.getElementById('invRarityFilter');
    const cur = sel.value;
    const allItems = activeInvTab && inventories[activeInvTab] ? inventories[activeInvTab].items : [];
    const rarities = [...new Set(allItems.map(it => it.rarity).filter(Boolean))].sort();
    sel.innerHTML = '<option value="">Todas as raridades</option>' +
        rarities.map(r => `<option value="${r}" ${r===cur?'selected':''}>${r}</option>`).join('');
}

function renderInvGrid() {
    const grid = document.getElementById('invGrid');
    if (!activeInvTab || !inventories[activeInvTab]) { grid.innerHTML = ''; return; }

    const inv = inventories[activeInvTab];
    const searchTerm = (document.getElementById('invSearch').value || '').toLowerCase();
    const rarityFilter = document.getElementById('invRarityFilter').value;
    const sortMode = document.getElementById('invSortMode').value;

    let items = [...inv.items];
    if (searchTerm) items = items.filter(it => it.name.toLowerCase().includes(searchTerm));
    if (rarityFilter) items = items.filter(it => it.rarity === rarityFilter);

    const isCS2 = inv.appId === 730;
    if (isCS2) {
        const w = { fn: document.getElementById('wearFN')?.checked??true, mw: document.getElementById('wearMW')?.checked??true, ft: document.getElementById('wearFT')?.checked??true, ww: document.getElementById('wearWW')?.checked??true, bs: document.getElementById('wearBS')?.checked??true };
        items = items.filter(it => {
            const n = (it.name||'').toLowerCase();
            if (n.includes('factory new') || n.includes('(fn)')) return w.fn;
            if (n.includes('minimal wear') || n.includes('(mw)')) return w.mw;
            if (n.includes('field-tested') || n.includes('(ft)')) return w.ft;
            if (n.includes('well-worn') || n.includes('(ww)')) return w.ww;
            if (n.includes('battle-scarred') || n.includes('(bs)')) return w.bs;
            return true;
        });
    }

    if (sortMode === 'price_desc') items.sort((a,b) => (b.price??-1) - (a.price??-1));
    else if (sortMode === 'price_asc') items.sort((a,b) => (a.price??Infinity) - (b.price??Infinity));
    else if (sortMode === 'count_desc') items.sort((a,b) => (b.count||1) - (a.count||1));
    else items.sort((a,b) => (a.name||'').localeCompare(b.name||''));

    const marketAppId = inv.appId || 730;
    grid.innerHTML = items.map(it => {
        const rarityColor = getRarityColor(it.rarity);
        const isPending = it.price === null;
        const priceHtml = isPending
            ? `<div class="inv-price" style="color:var(--text3);font-size:.68rem">⏳ aguardando...</div>`
            : `<div class="inv-price">${it.price >= 0 ? fmtBRL(it.price) : '—'}</div>`;
        const marketUrl = `https://steamcommunity.com/market/listings/${marketAppId}/${encodeURIComponent(it.name)}`;
        return `<div class="inv-card ${isPending?'pending-price':'has-price'}" title="${it.name}" onclick="window.open('${marketUrl}','_blank')">
            <img src="${it.imageUrl||''}" alt="${it.name}" onerror="this.src='https://placehold.co/120x75/0d1524/00e5ff?text=?'">
            <div class="inv-card-info">
                <div class="inv-name">${it.name}</div>
                ${priceHtml}
                ${(it.count||1)>1?`<div class="inv-count">x${it.count}${it.unitPrice!=null&&!isPending?' · '+fmtBRL(it.unitPrice):''}</div>`:''}
                ${it.rarity?`<div class="inv-rarity" style="color:${rarityColor}">${it.rarity}</div>`:''}
            </div>
        </div>`;
    }).join('');
}

function renderRarityChart() {
    if (!activeInvTab || !inventories[activeInvTab]) return;
    const items = inventories[activeInvTab].items;
    const rarityMap = {};
    for (const it of items) {
        const r = it.rarity || 'Sem raridade';
        if (!rarityMap[r]) rarityMap[r] = { count: 0, value: 0 };
        rarityMap[r].count += (it.count||1);
        rarityMap[r].value += (it.price > 0 ? it.price : 0);
    }
    if (!Object.keys(rarityMap).length) return;
    document.getElementById('invRarityChart').style.display = 'block';
    const sorted = Object.entries(rarityMap).sort((a,b) => b[1].count - a[1].count);
    document.getElementById('invRarityChips').innerHTML = sorted.map(([rarity, data]) => {
        const color = getRarityColor(rarity);
        return `<div class="inv-rarity-chip ${activeRarityFilter===rarity?'active':''}"
            style="color:${color};border-color:${color}40;background:${color}18"
            onclick="toggleRarityFilter('${rarity.replace(/'/g,"\\'")}')">
            ${rarity} (${data.count})</div>`;
    }).join('');
    const ctx = document.getElementById('rarityCanvas').getContext('2d');
    if (rarityChart) rarityChart.destroy();
    rarityChart = new Chart(ctx, {
        type: 'doughnut',
        data: { labels:sorted.map(([r])=>r), datasets:[{data:sorted.map(([,d])=>d.count),borderColor:'rgba(0,0,0,.3)',backgroundColor: sorted.map(([r])=>getRarityColor(r)+'bb'),borderWidth:2}] },
        options: { responsive:true, maintainAspectRatio:false,plugins:{legend:{position:'right',labels:{color:'#8fadc8',font:{family:'Exo 2'}}}, tooltip:{callbacks:{label:ctx=>` ${ctx.label}: ${ctx.raw} itens`}} } }
    });
}

function toggleRarityFilter(rarity) {
    activeRarityFilter = activeRarityFilter === rarity ? '' : rarity;
    document.getElementById('invRarityFilter').value = activeRarityFilter;
    renderRarityChart();
    renderInvGrid();
}

function startLazyPricing() {
    const url = document.getElementById('profileUrl').value.trim();
    if (!url) { showError('Insira a URL do perfil primeiro'); return; }
    _lazyPricingQueue = [];
    for (const [,inv] of Object.entries(inventories)) {
        if (inv.hasRealPrices) continue;
        for (const item of inv.items) {
            if (item.price === null && item.appId) _lazyPricingQueue.push({name:item.name,appId:item.appId});
        }
    }
    const seen = new Set();
    _lazyPricingQueue = _lazyPricingQueue.filter(it => { const k=`${it.appId}:${it.name}`; if(seen.has(k))return false; seen.add(k); return true; });
    if (!_lazyPricingQueue.length) { document.getElementById('priceQueueInfo').textContent = '✓ Todos os itens já têm preço!'; return; }
    _lazyPricingActive = true;
    document.getElementById('btnPriceAllItems').disabled = true;
    document.getElementById('btnPriceAllItems').textContent = '⏳ Precificando...';
    document.getElementById('priceQueueInfo').style.display = '';
    pricingStep();
}

function pricingStep() {
    if (!_lazyPricingActive || !_lazyPricingQueue.length) {
        document.getElementById('btnPriceAllItems').disabled = false;
        document.getElementById('btnPriceAllItems').textContent = '✓ Precificado!';
        document.getElementById('priceQueueInfo').textContent = '✓ Todos os itens precificados!';
        return;
    }
    const item = _lazyPricingQueue.shift();
    document.getElementById('priceQueueInfo').textContent = `⏳ Precificando "${item.name.slice(0,30)}…" — ${_lazyPricingQueue.length} restantes`;
    ensureConnected(() => connection.invoke('PriceInventoryItem', item.name, item.appId).catch(()=>{}));
    setTimeout(pricingStep, 3600);
}

function getRarityColor(rarity) {
    if (!rarity) return 'var(--text3)';
    const r = rarity.toLowerCase();
    if (r.includes('covert')) return '#ff4444';
    if (r.includes('classified')) return '#eb4b4b';
    if (r.includes('restricted')) return '#8847ff';
    if (r.includes('mil-spec') || r.includes('milspec')) return '#4b69ff';
    if (r.includes('industrial')) return '#5e98d9';
    if (r.includes('contraband')) return '#e4ae39';
    if (r.includes('arcana') || r.includes('ancient')) return '#eb4b4b';
    if (r.includes('immortal')) return '#e4ae39';
    if (r.includes('legendary')) return '#d32ce6';
    if (r.includes('mythical') || r.includes('rare')) return '#8847ff';
    if (r.includes('consumer')) return '#b0c3d9';
    return 'var(--text2)';
}

