                <div class="tp"><div class="tp-val" style="color:var(--cyan)">${t.currentPrice!=null?fmtBRL(t.currentPrice):'—'}</div><div class="tp-lbl">Atual</div></div>
                <div class="tp"><div class="tp-val" style="color:var(--green)">${fmtBRL(t.minPrice)}</div><div class="tp-lbl">Mín 90d</div></div>
                <div class="tp"><div class="tp-val" style="color:var(--red)">${fmtBRL(t.maxPrice)}</div><div class="tp-lbl">Máx 90d</div></div>
                <div class="tp"><div class="tp-val">${fmtBRL(t.avgPrice)}</div><div class="tp-lbl">Média</div></div>
                <div class="tp"><div class="tp-val ${trendCls}">${trend} ${trendTxt}</div><div class="tp-lbl">Tendência</div></div>
            </div>
            <div class="tracker-chart-wrap"><canvas id="tchart_${i}"></canvas></div>
        </div>`;
    }).join('');
    requestAnimationFrame(() => {
        items.forEach((t,i) => {
            const canvas = document.getElementById(`tchart_${i}`);
            if (!canvas||!t.priceHistory||t.priceHistory.length<2) return;
            const ctx = canvas.getContext('2d');
            const prices = t.priceHistory.map(p=>p.price||p);
            if (_trackerCharts[i]) _trackerCharts[i].destroy();
            _trackerCharts[i] = new Chart(ctx, { type:'line', data:{ labels:prices.map((_,idx)=>''), datasets:[{data:prices,borderColor:t.trend>0.05?'#00e676':t.trend<-0.05?'#ff1744':'#00e5ff',backgroundColor:'transparent',tension:.4,pointRadius:0,borderWidth:2}]}, options:{ responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{display:false},y:{display:false}}}});
        });
    });
}

// ── Countries ──
function renderCountries(data) {
    if (!data.length) { document.getElementById('countriesList').innerHTML='<p style="color:var(--text3);padding:14px">Nenhum dado de país encontrado.</p>'; return; }
    const total = data.reduce((s,c)=>s+c.count,0);
    const countryNames = {BR:'Brasil',US:'Estados Unidos',DE:'Alemanha',GB:'Reino Unido',UK:'Reino Unido',FR:'França',RU:'Rússia',PL:'Polônia',CA:'Canadá',AU:'Austrália',NL:'Holanda',SE:'Suécia',FI:'Finlândia',NO:'Noruega',AR:'Argentina',MX:'México',ES:'Espanha',PT:'Portugal',IT:'Itália',JP:'Japão',KR:'Coreia do Sul',CN:'China',IN:'Índia',TR:'Turquia',UA:'Ucrânia'};
    const flags = {BR:'🇧🇷',US:'🇺🇸',DE:'🇩🇪',GB:'🇬🇧',UK:'🇬🇧',FR:'🇫🇷',RU:'🇷🇺',PL:'🇵🇱',CA:'🇨🇦',AU:'🇦🇺',NL:'🇳🇱',SE:'🇸🇪',FI:'🇫🇮',NO:'🇳🇴',AR:'🇦🇷',MX:'🇲🇽',ES:'🇪🇸',PT:'🇵🇹',IT:'🇮🇹',JP:'🇯🇵',KR:'🇰🇷',CN:'🇨🇳',IN:'🇮🇳',TR:'🇹🇷',UA:'🇺🇦'};
    const maxCount = data[0].count;
    document.getElementById('countriesList').innerHTML = data.map(c => {
        const name = countryNames[c.code]||c.code;
        const flag = flags[c.code]||'🌐';
        const pct = Math.round(c.count/total*100);
        return `<div class="country-row">
            <div class="country-name">${flag} ${name}</div>
            <div class="country-bar-bg"><div class="country-bar-fill" style="width:${Math.round(c.count/maxCount*100)}%"></div></div>
            <div style="font-size:.75rem;color:var(--text3);flex-shrink:0;width:38px;text-align:right">${pct}%</div>
            <div class="country-count">${c.count}</div>
        </div>`;
    }).join('');
    const ctx = document.getElementById('countriesCanvas').getContext('2d');
    if (countriesChart) countriesChart.destroy();
    const top10 = data.slice(0,10);
    const colors = ['#00e5ff','#ff5722','#ffd740','#00e676','#e040fb','#69ff47','#40c4ff','#ff6e40','#b2ff59','#ff4081'];
    countriesChart = new Chart(ctx, { type:'doughnut', data:{ labels:top10.map(c=>(flags[c.code]||'🌐')+' '+(countryNames[c.code]||c.code)), datasets:[{data:top10.map(c=>c.count),backgroundColor:colors,borderColor:'rgba(0,0,0,.3)',borderWidth:2}]}, options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'right',labels:{color:'#8fadc8',font:{family:'Exo 2'}}}, tooltip:{callbacks:{label:ctx=>` ${ctx.label}: ${ctx.raw} itens`}}}}});
}

// ── History Chart ──
function updateHistChart() {
    if (!snapshotData.length) return;
    const ctx = document.getElementById('histChart').getContext('2d');
    if (histChart) { histChart.data.labels=snapshotData.map(s=>s.time); histChart.data.datasets[0].data=snapshotData.map(s=>s.total); histChart.update(); return; }
    histChart = new Chart(ctx, { type:'line', data:{ labels:snapshotData.map(s=>s.time), datasets:[{label:'Valor total (R$)',data:snapshotData.map(s=>s.total),borderColor:'#00e5ff',backgroundColor:'rgba(0,229,255,.08)',tension:.4,fill:true,pointBackgroundColor:'#ff5722',pointRadius:5,pointHoverRadius:8}]}, options:{ responsive:true,maintainAspectRatio:false, plugins:{legend:{labels:{color:'#8fadc8',font:{family:'Exo 2'}}}}, scales:{ x:{ticks:{color:'#8fadc8'},grid:{color:'rgba(255,255,255,.04)'}}, y:{ticks:{color:'#8fadc8',callback:v=>'R$ '+v.toLocaleString('pt-BR')},grid:{color:'rgba(255,255,255,.04)'}}}}});
