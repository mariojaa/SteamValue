@model CalculateViewModel
@{
    ViewData["Title"] = "Steam Value Calculator";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@300;400;500;600;700&family=Russo+One&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@latest/dist/browser/signalr.min.js"></script>
    <style>
        :root {
            --primary: #ff6b35;
            --secondary: #00d9ff;
            --accent: #ffeb3b;
            --dark-bg: #0a0e27;
            --card-bg: #141b2d;
            --border-color: #1e3a5f;
            --text-primary: #ffffff;
            --text-secondary: #8b9dc3;
            --success: #4caf50;
            --warning: #ff9800;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Rajdhani', sans-serif;
            background: var(--dark-bg);
            color: var(--text-primary);
            min-height: 100vh;
            position: relative;
            overflow-x: hidden;
        }

        /* Animated background */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: 
                radial-gradient(circle at 20% 50%, rgba(0, 217, 255, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(255, 107, 53, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 40% 20%, rgba(255, 235, 59, 0.05) 0%, transparent 40%);
            z-index: 0;
            animation: backgroundShift 15s ease-in-out infinite;
        }

        @@keyframes backgroundShift {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
            position: relative;
            z-index: 1;
        }

        .header {
            text-align: center;
            margin-bottom: 3rem;
            position: relative;
        }

        .header::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, var(--secondary) 0%, transparent 70%);
            opacity: 0.1;
            filter: blur(60px);
            z-index: -1;
        }

        h1 {
            font-family: 'Russo One', sans-serif;
            font-size: 3.5rem;
            background: linear-gradient(135deg, var(--primary), var(--secondary), var(--accent));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 3px;
            animation: titleGlow 3s ease-in-out infinite;
        }

        @@keyframes titleGlow {
            0%, 100% { filter: drop-shadow(0 0 20px rgba(255, 107, 53, 0.5)); }
            50% { filter: drop-shadow(0 0 40px rgba(0, 217, 255, 0.7)); }
        }

        .subtitle {
            color: var(--text-secondary);
            font-size: 1.2rem;
            font-weight: 300;
            letter-spacing: 2px;
        }

        .calculator-card {
            background: var(--card-bg);
            border: 2px solid var(--border-color);
            border-radius: 20px;
            padding: 3rem;
            margin-bottom: 2rem;
            box-shadow: 
                0 10px 40px rgba(0, 0, 0, 0.5),
                inset 0 1px 0 rgba(255, 255, 255, 0.1);
            position: relative;
            overflow: hidden;
        }

        .calculator-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, transparent 0%, rgba(0, 217, 255, 0.05) 100%);
            pointer-events: none;
        }

        .form-group {
            margin-bottom: 2rem;
            position: relative;
        }

        label {
            display: block;
            margin-bottom: 0.8rem;
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--text-primary);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .input-wrapper {
            position: relative;
        }

        input[type="text"] {
            width: 100%;
            padding: 1.2rem 1.5rem;
            background: rgba(10, 14, 39, 0.6);
            border: 2px solid var(--border-color);
            border-radius: 10px;
            color: var(--text-primary);
            font-size: 1.1rem;
            font-family: 'Rajdhani', sans-serif;
            transition: all 0.3s ease;
        }

        input[type="text"]:focus {
            outline: none;
            border-color: var(--secondary);
            box-shadow: 0 0 20px rgba(0, 217, 255, 0.3);
        }

        .checkbox-group {
            display: flex;
            gap: 2rem;
            margin-bottom: 2rem;
        }

        .checkbox-wrapper {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            cursor: pointer;
            transition: transform 0.2s ease;
        }

        .checkbox-wrapper:hover {
            transform: translateX(5px);
        }

        input[type="checkbox"] {
            width: 24px;
            height: 24px;
            cursor: pointer;
            accent-color: var(--secondary);
        }

        .checkbox-wrapper label {
            margin: 0;
            cursor: pointer;
            font-size: 1.1rem;
            text-transform: none;
        }

        .btn-calculate {
            width: 100%;
            padding: 1.5rem;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border: none;
            border-radius: 12px;
            color: var(--text-primary);
            font-size: 1.3rem;
            font-weight: 700;
            font-family: 'Russo One', sans-serif;
            text-transform: uppercase;
            letter-spacing: 2px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 5px 20px rgba(255, 107, 53, 0.4);
            position: relative;
            overflow: hidden;
        }

        .btn-calculate::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            transform: translate(-50%, -50%);
            transition: width 0.6s, height 0.6s;
        }

        .btn-calculate:hover::before {
            width: 400px;
            height: 400px;
        }

        .btn-calculate:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 30px rgba(0, 217, 255, 0.6);
        }

        .btn-calculate:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

        /* Progress Bar */
        .progress-container {
            display: none;
            margin-top: 2rem;
            padding: 2rem;
            background: rgba(10, 14, 39, 0.6);
            border: 2px solid var(--border-color);
            border-radius: 15px;
        }

        .progress-container.active {
            display: block;
            animation: slideDown 0.4s ease;
        }

        @@keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .progress-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

        .progress-label {
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--secondary);
        }

        .progress-percentage {
            font-size: 1.5rem;
            font-weight: 700;
            font-family: 'Russo One', sans-serif;
            color: var(--accent);
        }

        .progress-bar-wrapper {
            height: 30px;
            background: rgba(30, 58, 95, 0.5);
            border-radius: 15px;
            overflow: hidden;
            position: relative;
            box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.5);
        }

        .progress-bar {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, var(--primary), var(--secondary), var(--accent));
            background-size: 200% 100%;
            border-radius: 15px;
            transition: width 0.5s ease;
            animation: progressShine 2s linear infinite;
            position: relative;
            box-shadow: 0 0 20px rgba(0, 217, 255, 0.6);
        }

        @@keyframes progressShine {
            0% { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }

        .progress-bar::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 50%;
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.3), transparent);
            border-radius: 15px 15px 0 0;
        }

        .status-message {
            margin-top: 1rem;
            padding: 1rem;
            background: rgba(0, 217, 255, 0.1);
            border-left: 4px solid var(--secondary);
            border-radius: 5px;
            font-size: 1rem;
            color: var(--text-secondary);
            font-weight: 500;
        }

        /* Results Container */
        .results-container {
            display: none;
            margin-top: 2rem;
        }

        .results-container.active {
            display: block;
            animation: fadeIn 0.5s ease;
        }

        @@keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .results-section {
            background: var(--card-bg);
            border: 2px solid var(--border-color);
            border-radius: 15px;
            padding: 2rem;
            margin-bottom: 1.5rem;
            position: relative;
            overflow: hidden;
        }

        .results-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, var(--primary), var(--secondary));
        }

        .results-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .results-icon {
            font-size: 2rem;
        }

        .results-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--secondary);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .item-list {
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
        }

        .item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 1.5rem;
            background: rgba(10, 14, 39, 0.6);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            transition: all 0.3s ease;
            animation: itemSlide 0.4s ease;
        }

        @@keyframes itemSlide {
            from {
                opacity: 0;
                transform: translateX(-20px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .item:hover {
            border-color: var(--secondary);
            background: rgba(0, 217, 255, 0.1);
            transform: translateX(10px);
        }

        .item-name {
            font-size: 1.1rem;
            font-weight: 500;
        }

        .item-value {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--accent);
        }

        .total-value {
            margin-top: 2rem;
            padding: 2rem;
            background: linear-gradient(135deg, rgba(255, 107, 53, 0.2), rgba(0, 217, 255, 0.2));
            border: 2px solid var(--accent);
            border-radius: 15px;
            text-align: center;
            animation: pulse 2s ease-in-out infinite;
        }

        @@keyframes pulse {
            0%, 100% { box-shadow: 0 0 20px rgba(255, 235, 59, 0.4); }
            50% { box-shadow: 0 0 40px rgba(255, 235, 59, 0.8); }
        }

        .total-label {
            font-size: 1.3rem;
            color: var(--text-secondary);
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .total-amount {
            font-size: 3rem;
            font-weight: 700;
            font-family: 'Russo One', sans-serif;
            color: var(--accent);
            text-shadow: 0 0 20px rgba(255, 235, 59, 0.5);
        }

        .error-message {
            padding: 1.5rem;
            background: rgba(255, 107, 53, 0.2);
            border: 2px solid var(--primary);
            border-radius: 10px;
            color: var(--text-primary);
            margin-top: 2rem;
            animation: shake 0.5s ease;
        }

        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-10px); }
            75% { transform: translateX(10px); }
        }

        /* Loading Animation */
        .loading-dots {
            display: inline-block;
        }

        .loading-dots span {
            animation: blink 1.4s infinite;
            animation-fill-mode: both;
        }

        .loading-dots span:nth-child(2) {
            animation-delay: 0.2s;
        }

        .loading-dots span:nth-child(3) {
            animation-delay: 0.4s;
        }

        @@keyframes blink {
            0%, 80%, 100% { opacity: 0; }
            40% { opacity: 1; }
        }

        @@media (max-width: 768px) {
            h1 {
                font-size: 2.5rem;
            }

            .calculator-card {
                padding: 2rem;
            }

            .checkbox-group {
                flex-direction: column;
                gap: 1rem;
            }

            .total-amount {
                font-size: 2rem;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Steam Value Calculator</h1>
            <p class="subtitle">Calcule o valor da sua conta Steam em tempo real</p>
        </div>

        <div class="calculator-card">
            <form id="calculatorForm">
                <div class="form-group">
                    <label for="profileUrl">🔗 Link do Perfil Steam</label>
                    <div class="input-wrapper">
                        <input type="text" 
                               id="profileUrl" 
                               name="profileUrl" 
                               placeholder="https://steamcommunity.com/id/seu-perfil" 
                               required>
                    </div>
                </div>

                <div class="checkbox-group">
                    <div class="checkbox-wrapper">
                        <input type="checkbox" id="calculateGames" name="calculateGames" checked>
                        <label for="calculateGames">🎮 Valor dos Jogos</label>
                    </div>
                    <div class="checkbox-wrapper">
                        <input type="checkbox" id="calculateInventory" name="calculateInventory" checked>
                        <label for="calculateInventory">📦 Valor do Inventário</label>
                    </div>
                </div>

                <button type="submit" class="btn-calculate" id="btnCalculate">
                    <span>Iniciar Cálculo</span>
                </button>
            </form>

            <!-- Progress Bar -->
            <div class="progress-container" id="progressContainer">
                <div class="progress-header">
                    <span class="progress-label">Processando</span>
                    <span class="progress-percentage" id="progressPercentage">0%</span>
                </div>
                <div class="progress-bar-wrapper">
                    <div class="progress-bar" id="progressBar"></div>
                </div>
                <div class="status-message" id="statusMessage">
                    Iniciando<span class="loading-dots"><span>.</span><span>.</span><span>.</span></span>
                </div>
            </div>
        </div>

        <!-- Results Container -->
        <div class="results-container" id="resultsContainer">
            <div id="resultsContent"></div>
        </div>

        <div id="errorContainer"></div>
    </div>

    <script src="~/js/Signalr calculator.js"></script>
</body>
</html>
