// ── Skin Watchlist ──
function getWatchlist() { try { return JSON.parse(localStorage.getItem('sv_watchlist')||'[]'); } catch { return []; } }
function saveWatchlist(list) { try { localStorage.setItem('sv_watchlist', JSON.stringify(list)); } catch {} }

function addToWatchlist() {
    const appId = parseInt(document.getElementById('wlAppId').value);
    const name = document.getElementById('wlItemName').value.trim();
    if (!name) { showError('Digite o nome do item'); return; }
    const list = getWatchlist();
    if (list.find(it => it.name===name && it.appId===appId)) { showError('Item já está na watchlist'); return; }
    list.push({ name, appId, addedAt: Date.now(), price: null, prevPrice: null });
    saveWatchlist(list);
    document.getElementById('wlItemName').value = '';
    renderWatchlistItems();
    _watchlistPriceWait.add(`${appId}:${name}`);
    ensureConnected(() => connection.invoke('PriceInventoryItem', name, appId).catch(()=>{}));
}

function removeFromWatchlist(name, appId) {
    saveWatchlist(getWatchlist().filter(it => !(it.name===name && it.appId===appId)));
    renderWatchlistItems();
}

function refreshWatchlist() {
    const list = getWatchlist();
    if (!list.length) return;
    showFeaturePanel('watchlist');
    document.getElementById('watchlistGrid').innerHTML = '<p style="color:var(--text2);font-style:italic;padding:10px">Atualizando preços...</p>';
    list.forEach(it => {
        _watchlistPriceWait.add(`${it.appId}:${it.name}`);
        ensureConnected(() => connection.invoke('PriceInventoryItem', it.name, it.appId).catch(()=>{}));
    });
}

function handleWatchlistPrice(name, appId, price) {
    const key = `${appId}:${name}`;
    if (!_watchlistPriceWait.has(key)) return;
    _watchlistPriceWait.delete(key);
    const list = getWatchlist();
    const item = list.find(it => it.name===name && it.appId===appId);
    if (item) { item.prevPrice = item.price; item.price = price; item.updatedAt = Date.now(); saveWatchlist(list); renderWatchlistItems(); }
}

function renderWatchlistItems() {
    const list = getWatchlist();
    const grid = document.getElementById('watchlistGrid');
    const empty = document.getElementById('watchlistEmpty');
    if (!list.length) { grid.innerHTML=''; empty.style.display=''; return; }
    empty.style.display='none';
    const gameNames = {730:'CS2',570:'Dota 2',440:'TF2',252490:'Rust',1172470:'Apex',578080:'PUBG'};
    grid.innerHTML = list.map(it => {
        const trend = it.prevPrice!=null&&it.price!=null ? it.price-it.prevPrice : 0;
        const trendCls = trend>0.01?'watchlist-trend-up':trend<-0.01?'watchlist-trend-down':'watchlist-trend-flat';
        const trendIcon = trend>0.01?'📈':trend<-0.01?'📉':'➡️';
        const trendTxt = Math.abs(trend)>0.01 ? `${trend>0?'+':''}${fmtBRL(trend)}` : '';
        const updatedTxt = it.updatedAt ? new Date(it.updatedAt).toLocaleString('pt-BR',{hour:'2-digit',minute:'2-digit',day:'2-digit',month:'short'}) : '';
        return `<div class="watchlist-item">
            <div style="flex:1;min-width:0">
                <div style="font-size:.88rem;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${it.name}">${it.name}</div>
                <div style="font-size:.72rem;color:var(--text3);margin-top:2px">${gameNames[it.appId]||it.appId}${updatedTxt?' · '+updatedTxt:''}</div>
            </div>
            <div style="text-align:right;flex-shrink:0">
                ${it.price!=null?`<span class="watchlist-price">${fmtBRL(it.price)}</span>`:`<span style="color:var(--text3);font-size:.8rem">⏳ carregando...</span>`}
                ${trendTxt?`<div class="${trendCls}" style="font-size:.75rem;margin-top:2px">${trendIcon} ${trendTxt}</div>`:''}
            </div>
            <button class="btn btn-ghost btn-sm" onclick="removeFromWatchlist('${it.name.replace(/'/g,"\\'")}',${it.appId})" title="Remover">✕</button>
        </div>`;
    }).join('');
}

// ── CSV Export ──
function exportCSV() {
    if (!allGames.length && !Object.keys(inventories).length) { showError('Calcule sua conta primeiro!'); return; }
    const rows = ['Tipo,Nome,Preço (R$),Horas,Gênero,Metacritic'];
    allGames.forEach(g => rows.push(`"Jogo","${(g.name||'').replace(/"/g,'""')}","${(g.price||0).toFixed(2)}","${Math.round((g.playtimeMinutes||0)/60)}","${g.genre||''}","${g.metacritic||''}"`));
    Object.entries(inventories).forEach(([game,{items}]) =>
        items.forEach(it => rows.push(`"Inventário ${game}","${(it.name||'').replace(/"/g,'""')}","${(it.price||0).toFixed(2)}","","",""`)));
    const blob = new Blob(['\ufeff'+rows.join('\n')], {type:'text/csv;charset=utf-8;'});
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob);
    a.download = `steam_value_${new Date().toISOString().slice(0,10)}.csv`; a.click();
}

// ── Helpers ──
function fmtBRL(v) {
    if (v===null||v===undefined) return 'R$ 0,00';
    return 'R$ '+Number(v||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});
}
function fmtTime(m) { if (!m) return '0min'; return m<60?m+'min':Math.round(m/60)+'h'; }
function showError(msg) { document.getElementById('errorBox').innerHTML=`<div class="error-box">⚠ ${msg}</div>`; }
function hideError() { const e=document.getElementById('errorBox'); if(e) e.innerHTML=''; }
function showProgress(msg) {
    document.getElementById('progressWrap').classList.add('active');
    document.getElementById('progressBar').style.width='5%';
    document.getElementById('progressPct').textContent='...';
    document.getElementById('progressMsg').textContent=msg;
}
function showLoading(containerId, msg) {
    const el = document.getElementById(containerId);
    if (el) el.innerHTML=`<div style="display:flex;align-items:center;gap:12px;padding:28px 14px;color:var(--text2);font-style:italic"><div style="width:20px;height:20px;border:2px solid rgba(0,229,255,.3);border-top-color:var(--cyan);border-radius:50%;animation:spin .7s linear infinite;flex-shrink:0"></div>${msg}</div>`;
}

