@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@removeTagHelper Microsoft.AspNetCore.Mvc.TagHelpers.BodyTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers
@model CalculateViewModel
@{
    ViewData["Title"] = "Steam Value Calculator";
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SteamValue — Calculadora de Conta</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Exo+2:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        :root {
            --bg: #060b14;
            --bg1: #0d1524;
            --bg2: #111d2e;
            --bg3: #162236;
            --border: #1a3050;
            --border2: #243f5e;
            --cyan: #00e5ff;
            --cyan2: #00b8d9;
            --orange: #ff5722;
            --orange2: #e64a19;
            --gold: #ffd740;
            --green: #00e676;
            --red: #ff1744;
            --purple: #e040fb;
            --text: #cdd9e5;
            --text2: #8fadc8;
            --text3: #4a6480;
            --online: #00e676;
            --offline: #546e7a;
        }
        *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
        html { scroll-behavior: smooth; }
        body {
            font-family: 'Exo 2', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            overflow-x: hidden;
        }

        body::before {
            content: '';
            position: fixed; inset: 0; z-index: 0; pointer-events: none;
            background:
                radial-gradient(ellipse 60% 40% at 20% 30%, rgba(0,229,255,.05) 0%, transparent 70%),
                radial-gradient(ellipse 50% 50% at 80% 70%, rgba(255,87,34,.05) 0%, transparent 70%),
                repeating-linear-gradient(0deg, transparent, transparent 59px, rgba(255,255,255,.012) 60px),
                repeating-linear-gradient(90deg, transparent, transparent 59px, rgba(255,255,255,.012) 60px);
        }

        .nav {
            display: flex; align-items: center; justify-content: space-between;
            padding: 0 40px; height: 60px;
            background: rgba(6,11,20,.92);
            border-bottom: 1px solid var(--border);
            backdrop-filter: blur(20px);
            position: sticky; top: 0; z-index: 200;
        }
        .nav-brand {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.2rem; font-weight: 900;
            background: linear-gradient(90deg, var(--cyan), var(--orange));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            letter-spacing: 2px;
        }
        .nav-links { display: flex; gap: 6px; }
        .nav-link {
            padding: 6px 16px; border-radius: 6px;
            color: var(--text2); text-decoration: none;
            font-size: .88rem; font-weight: 500; letter-spacing: .5px;
            transition: all .2s; border: 1px solid transparent;
        }
        .nav-link:hover, .nav-link.active {
            color: var(--cyan); border-color: rgba(0,229,255,.25);
            background: rgba(0,229,255,.06);
        }

        .page { max-width: 1360px; margin: 0 auto; padding: 32px 24px; position: relative; z-index: 1; }

        .hero { text-align: center; padding: 56px 0 40px; }
        .hero-badge {
            display: inline-block; margin-bottom: 18px;
            padding: 5px 16px; border-radius: 99px;
            background: rgba(0,229,255,.1); border: 1px solid rgba(0,229,255,.3);
            font-size: .78rem; color: var(--cyan); text-transform: uppercase; letter-spacing: 2px;
        }
        .hero h1 {
            font-family: 'Orbitron', sans-serif;
            font-size: clamp(2.2rem, 5vw, 4rem); font-weight: 900;
            line-height: 1.1; letter-spacing: 2px; text-transform: uppercase;
            background: linear-gradient(135deg, #ffffff 0%, var(--cyan) 50%, var(--orange) 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 0 40px rgba(0,229,255,.25));
        }
        .hero p { color: var(--text2); font-size: 1.1rem; margin-top: 12px; letter-spacing: .5px; }

        .card {
            background: var(--bg1);
            border: 1px solid var(--border);
            border-radius: 14px;
            position: relative; overflow: hidden;
        }
        .card::before {
            content: ''; position: absolute; inset: 0; pointer-events: none;
            background: linear-gradient(135deg, rgba(0,229,255,.025) 0%, transparent 50%);
        }
        .card-body { padding: 24px; }

        .form-section { margin-bottom: 28px; }
        .field-label {
            font-size: .78rem; font-weight: 700; text-transform: uppercase;
            letter-spacing: 1.5px; color: var(--text2); margin-bottom: 10px; display: block;
        }
        .input-row { display: flex; gap: 10px; }
        .steam-input {
            flex: 1; padding: 14px 18px;
            background: rgba(0,0,0,.4); border: 1.5px solid var(--border);
            border-radius: 10px; color: #fff;
            font-size: .95rem; font-family: 'Exo 2', sans-serif;
            transition: border-color .25s, box-shadow .25s;
        }
        .steam-input:focus { outline: none; border-color: var(--cyan); box-shadow: 0 0 0 3px rgba(0,229,255,.1); }
        .steam-input::placeholder { color: var(--text3); }

        .btn {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 12px 22px; border: none; border-radius: 10px;
            font-family: 'Exo 2', sans-serif; font-size: .92rem; font-weight: 700;
            cursor: pointer; transition: all .2s; white-space: nowrap; letter-spacing: .5px;
        }
        .btn-primary {
            background: linear-gradient(135deg, var(--cyan), var(--cyan2));
            color: #000;
            box-shadow: 0 4px 20px rgba(0,229,255,.3);
        }
        .btn-primary:hover { filter: brightness(1.1); transform: translateY(-1px); box-shadow: 0 6px 28px rgba(0,229,255,.4); }
        .btn-orange {
            background: linear-gradient(135deg, var(--orange), var(--orange2));
            color: #fff; box-shadow: 0 4px 18px rgba(255,87,34,.25);
        }
        .btn-orange:hover { filter: brightness(1.1); transform: translateY(-1px); }
        .btn-ghost {
            background: rgba(255,255,255,.04); color: var(--text2);
            border: 1px solid var(--border);
        }
        .btn-ghost:hover { background: rgba(255,255,255,.09); color: var(--text); border-color: var(--border2); }
        .btn-sm { padding: 8px 14px; font-size: .82rem; }
        .btn:disabled { opacity: .45; pointer-events: none; }

        .checkbox-row { display: flex; gap: 22px; flex-wrap: wrap; margin: 16px 0; }
        .check-item { display: flex; align-items: center; gap: 10px; cursor: pointer; }
        .check-item input { width: 18px; height: 18px; accent-color: var(--cyan); cursor: pointer; }
        .check-item span { font-size: .95rem; font-weight: 500; }

        .action-bar { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 18px; }

        .feature-tabs {
            display: flex; gap: 4px; flex-wrap: wrap;
            border-bottom: 1px solid var(--border); margin-bottom: 20px;
        }
        .ftab {
            padding: 10px 18px; border-radius: 8px 8px 0 0;
            background: transparent; border: 1px solid transparent;
            border-bottom: none; color: var(--text2);
            font-family: 'Exo 2', sans-serif; font-size: .88rem; font-weight: 600;
            cursor: pointer; transition: all .2s; position: relative; bottom: -1px;
        }
        .ftab:hover { color: var(--text); background: rgba(255,255,255,.04); }
        .ftab.active {
            color: var(--cyan); background: var(--bg1);
            border-color: var(--border); border-bottom-color: var(--bg1);
        }
        .ftab-panel { display: none; }
        .ftab-panel.active { display: block; }

        .progress-wrap {
            display: none; margin-top: 18px;
            background: rgba(0,0,0,.4); border-radius: 10px; padding: 16px;
            border: 1px solid var(--border);
        }
        .progress-wrap.active { display: block; }
        .progress-meta { display: flex; justify-content: space-between; margin-bottom: 8px; }
        .progress-label { font-size: .78rem; color: var(--text2); text-transform: uppercase; letter-spacing: 1px; }
        .progress-pct { font-size: .82rem, color: var(--cyan); font-weight: 700; }
        .progress-bar-bg { height: 5px; background: rgba(255,255,255,.07); border-radius: 99px; overflow: hidden; }
        .progress-bar-fill {
            height: 100%; width: 0%;
            background: linear-gradient(90deg, var(--orange), var(--cyan));
            border-radius: 99px; transition: width .35s ease;
        }
        .progress-msg { font-size: .82rem; color: var(--text3); margin-top: 7px; font-style: italic; }

        .stats-grid {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 14px; margin-bottom: 24px;
        }
        .stat-card {
            background: var(--bg2); border: 1px solid var(--border);
            border-radius: 12px; padding: 18px 20px;
            position: relative; overflow: hidden;
        }
        .stat-card::after {
            content: attr(data-icon);
            position: absolute; right: 14px; bottom: 10px;
            font-size: 2.2rem; opacity: .12; filter: grayscale(1);
        }
        .stat-label { font-size: .72rem; color: var(--text3); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 6px; }
        .stat-value { font-family: 'Orbitron', sans-serif; font-size: 1.5rem; font-weight: 700; line-height: 1; }
        .stat-cyan { color: var(--cyan); }
        .stat-green { color: var(--green); }
        .stat-gold { color: var(--gold); }
        .stat-orange { color: var(--orange); }

        .total-box {
            background: linear-gradient(135deg, rgba(0,229,255,.08), rgba(255,87,34,.08));
            border: 2px solid var(--gold); border-radius: 14px;
            padding: 30px; text-align: center; margin-bottom: 24px;
            box-shadow: 0 0 40px rgba(255,215,64,.15);
            animation: totalPulse 3s ease-in-out infinite;
        }
        @@keyframes totalPulse {
            0%,100% { box-shadow: 0 0 40px rgba(255,215,64,.15); }
            50% { box-shadow: 0 0 60px rgba(255,215,64,.35); }
        }
        .total-label { font-size: .8rem; color: var(--text2); text-transform: uppercase; letter-spacing: 2px; margin-bottom: 8px; }
        .total-value { font-family: 'Orbitron', sans-serif; font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 900; color: var(--gold); text-shadow: 0 0 30px rgba(255,215,64,.5); }

        .profile-panel {
            display: none; background: var(--bg2); border: 1px solid var(--border);
            border-radius: 14px; padding: 24px; margin-bottom: 22px;
        }
        .profile-panel.visible { display: block; animation: fadeUp .3s ease; }
        @@keyframes fadeUp { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }
        .profile-header { display: flex; gap: 18px; align-items: flex-start; }
        .profile-avatar { width: 88px; height: 88px; border-radius: 8px; border: 2px solid var(--cyan); flex-shrink: 0; }
        .profile-name { font-family: 'Orbitron', sans-serif; font-size: 1.3rem; font-weight: 700; margin-bottom: 4px; color: #fff; }
        .profile-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
        .chip {
            padding: 4px 12px; border-radius: 6px; font-size: .78rem; font-weight: 600;
            background: rgba(255,255,255,.06); border: 1px solid var(--border);
        }
        .chip-cyan { background: rgba(0,229,255,.1); border-color: rgba(0,229,255,.3); color: var(--cyan); }
        .chip-red { background: rgba(255,23,68,.12); border-color: rgba(255,23,68,.3); color: var(--red); }
        .chip-green { background: rgba(0,230,118,.1); border-color: rgba(0,230,118,.3); color: var(--green); }
        .chip-gold { background: rgba(255,215,64,.1); border-color: rgba(255,215,64,.3); color: var(--gold); }
        .recent-games-strip { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 14px; }
        .mini-game { width: 100px; background: rgba(0,0,0,.3); border-radius: 6px; overflow: hidden; }
        .mini-game img { width: 100%; height: 50px; object-fit: cover; display: block; }
        .mini-info { padding: 5px 6px; font-size: .7rem; }
        .mini-name { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text); }
        .mini-time { color: var(--text3); }

        .section { margin-bottom: 22px; }
        .section-head {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 16px;
        }
        .section-title {
            font-family: 'Orbitron', sans-serif;
            font-size: .9rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px;
            color: var(--text2);
        }
        .section-badge {
            background: rgba(0,229,255,.12); color: var(--cyan);
            border-radius: 99px; padding: 3px 12px;
            font-size: .75rem; font-weight: 700;
        }

        .filter-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; align-items: center; }
        .select-s, .num-s, .text-s {
            padding: 8px 12px; background: rgba(0,0,0,.4);
            border: 1px solid var(--border); border-radius: 8px;
            color: var(--text); font-family: 'Exo 2', sans-serif; font-size: .85rem;
        }
        .games-grid {
            display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
            gap: 12px; max-height: 520px; overflow-y: auto; padding-right: 4px;
        }
        .games-grid::-webkit-scrollbar { width: 5px; }
        .games-grid::-webkit-scrollbar-thumb { background: rgba(0,229,255,.25); border-radius: 99px; }
        .game-card {
            background: var(--bg3); border: 1px solid var(--border);
            border-radius: 10px; overflow: hidden; cursor: pointer;
            transition: transform .18s, border-color .18s;
        }
        .game-card:hover { transform: translateY(-3px); border-color: rgba(0,229,255,.35); }
        .game-card img { width: 100%; height: 88px; object-fit: cover; display: block; }
        .game-card-info { padding: 10px; }
        .game-name { font-size: .82rem; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text); }
        .game-price { font-size: .78rem; color: var(--green); font-weight: 700; margin-top: 2px; }
        .game-playtime { font-size: .72rem; color: var(--text3); }
        .game-meta { font-size: .68rem; color: var(--text3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .metacritic-badge {
            display: inline-block; padding: 1px 5px; border-radius: 3px;
            font-size: .7rem; font-weight: 700; margin-right: 4px;
        }
        .mc-good { background: #6c3; color: #000; }
        .mc-ok { background: #fc3; color: #000; }
        .mc-bad { background: #f33; color: #fff; }

        .inv-tabs { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px; }
        .inv-tab {
            padding: 6px 14px; border-radius: 7px; border: 1px solid var(--border);
            background: rgba(255,255,255,.03); cursor: pointer;
            font-size: .82rem; font-weight: 600; transition: all .18s;
            font-family: 'Exo 2', sans-serif; color: var(--text2);
        }
        .inv-tab.active { background: rgba(255,87,34,.15); border-color: var(--orange); color: var(--orange); }
        .inv-grid {
            display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            gap: 8px; max-height: 380px; overflow-y: auto; padding-right: 4px;
        }
        .inv-grid::-webkit-scrollbar { width: 4px; }
        .inv-grid::-webkit-scrollbar-thumb { background: rgba(255,87,34,.25); border-radius: 99px; }
        .inv-card {
            background: rgba(0,0,0,.3); border: 1px solid var(--border);
            border-radius: 8px; overflow: hidden; transition: border-color .18s;
        }
        .inv-card:hover { border-color: rgba(255,215,64,.3); }
        .inv-card img { width: 100%; height: 75px; object-fit: cover; display: block; background: #0d1524; }
        .inv-card-info { padding: 7px; }
        .inv-name { font-size: .72rem; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .inv-price { font-size: .75rem; color: var(--gold); font-weight: 700; }
        .inv-count { font-size: .68rem; color: var(--text3); }
        .inv-rarity { font-size: .65rem; }

        .inv-filter-row { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:12px; align-items:center; }
        .inv-card.pending-price .inv-price { color:var(--text3); font-style:italic; }
        .inv-card.has-price { animation: priceIn .3s ease; }
        @@keyframes priceIn { from { border-color:rgba(255,215,64,.5); } to { border-color:var(--border); } }
        .inv-chart-wrap { height:200px; margin-bottom:18px; }
        .inv-rarity-breakdown { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:14px; }
        .inv-rarity-chip { padding:3px 10px; border-radius:99px; font-size:.72rem; font-weight:700; border:1px solid; cursor:pointer; transition:all .15s; }
        .inv-rarity-chip:hover { opacity:.8; }
        .inv-rarity-chip.active { box-shadow: 0 0 0 2px #fff4; }
        .inv-mode-tabs { display:flex; gap:6px; margin-bottom:12px; }
        .inv-mode-btn { padding:6px 14px; border-radius:7px; border:1px solid var(--border); background:rgba(255,255,255,.03);
            cursor:pointer; font-size:.82rem; font-weight:600; font-family:'Exo 2',sans-serif; color:var(--text2); transition:all .18s; }
        .inv-mode-btn.active { background:rgba(0,229,255,.12); border-color:rgba(0,229,255,.4); color:var(--cyan); }
        .price-queue-info { font-size:.75rem; color:var(--text3); font-style:italic; margin-bottom:8px; }

        .wish-list { display: flex; flex-direction: column; gap: 7px; max-height: 320px; overflow-y: auto; }
        .wish-item {
            display: flex; gap: 12px; align-items: center;
            background: rgba(0,0,0,.25); border-radius: 8px; padding: 10px 12px;
            border: 1px solid var(--border);
        }
        .wish-img { width: 80px; height: 40px; object-fit: cover; border-radius: 4px; flex-shrink: 0; }
        .wish-name { font-size: .88rem; font-weight: 600; color: var(--text); }
        .wish-priority { font-size: .72rem; color: var(--text3); }

        .badge-stats { display: flex; gap: 14px; flex-wrap: wrap; }
        .badge-stat { background: rgba(0,0,0,.3); border-radius: 8px; padding: 12px 18px; text-align: center; border: 1px solid var(--border); }
        .badge-stat-val { font-family: 'Orbitron', sans-serif; font-size: 1.4rem; font-weight: 700; color: var(--purple); }
        .badge-stat-lbl { font-size: .72rem; color: var(--text3); text-transform: uppercase; letter-spacing: .5px; }

        .chart-wrap { position: relative; height: 220px; }

        .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
        @@media (max-width: 768px) { .two-col { grid-template-columns: 1fr; } }

        .error-box {
            background: rgba(255,23,68,.1); border: 1px solid rgba(255,23,68,.3);
            border-radius: 10px; padding: 14px 18px; color: var(--red);
            margin-top: 14px; font-size: .9rem;
            animation: shake .35s ease;
        }
        @@keyframes shake {
            0%,100% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            75% { transform: translateX(5px); }
        }

        .spinner { display: inline-block; width: 16px; height: 16px; border: 2px solid rgba(0,0,0,.3); border-top-color: #000; border-radius: 50%; animation: spin .7s linear infinite; }
        @@keyframes spin { to { transform: rotate(360deg); } }

        .playtime-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin-bottom: 18px; }
        .pt-stat { background: var(--bg3); border: 1px solid var(--border); border-radius: 10px; padding: 14px; text-align: center; }
        .pt-val { font-family: 'Orbitron', sans-serif; font-size: 1.3rem; font-weight: 700; color: var(--cyan); }
        .pt-lbl { font-size: .7rem; color: var(--text3); text-transform: uppercase; letter-spacing: .5px; margin-top: 4px; }
        .pt-bar-wrap { height: 8px; background: rgba(255,255,255,.07); border-radius: 99px; overflow: hidden; margin: 10px 0; }
        .pt-bar { height: 100%; background: linear-gradient(90deg, var(--orange), var(--cyan)); border-radius: 99px; transition: width .6s ease; }
        .most-played-list { display: flex; flex-direction: column; gap: 8px; max-height: 300px; overflow-y: auto; }
        .mp-item { display: flex; gap: 10px; align-items: center; padding: 8px 10px; background: rgba(0,0,0,.25); border-radius: 7px; border: 1px solid var(--border); }
        .mp-item img { width: 60px; height: 34px; object-fit: cover; border-radius: 4px; flex-shrink: 0; }
        .mp-name { font-size: .85rem; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .mp-hours { font-size: .78rem; color: var(--gold); font-weight: 700; }

        .compare-row { display: flex; gap: 12px; align-items: center; margin-bottom: 18px; flex-wrap: wrap; }
        .vs-label { font-family: 'Orbitron', sans-serif; font-size: 1.1rem; font-weight: 900; color: var(--orange); padding: 0 6px; }
        .compare-grid { display: grid; grid-template-columns: 1fr auto 1fr; gap: 16px; align-items: start; }
        .compare-col { background: var(--bg3); border: 1px solid var(--border); border-radius: 12px; padding: 18px; }
        .compare-col.winner { border-color: var(--gold); background: rgba(255,215,64,.05); }
        .cmp-avatar { width: 64px; height: 64px; border-radius: 6px; border: 2px solid var(--border); }
        .cmp-name { font-weight: 700; font-size: 1.05rem; margin: 8px 0 12px; color: #fff; }
        .cmp-stat { display: flex; justify-content: space-between; padding: 7px 0; border-bottom: 1px solid rgba(255,255,255,.05); font-size: .88rem; }
        .cmp-stat:last-child { border-bottom: none; }
        .cmp-val { font-weight: 700; color: var(--cyan); }
        .cmp-val.better { color: var(--green); }
        .compare-vs { display: flex; align-items: center; justify-content: center; }

        .live-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px; }
        .live-card { background: var(--bg3); border: 1px solid var(--border); border-radius: 10px; padding: 14px; text-align: center; }
        .live-game { font-size: .85rem; font-weight: 700; margin-bottom: 6px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .live-count { font-family: 'Orbitron', sans-serif; font-size: 1.3rem; font-weight: 700; color: var(--green); }
        .live-lbl { font-size: .7rem; color: var(--text3); margin-top: 3px; }

        .watchlist-item { display:flex; gap:12px; align-items:center; padding:12px 14px; background:rgba(0,0,0,.25); border-radius:10px; border:1px solid var(--border); }
        .watchlist-item img { width:64px; height:48px; object-fit:cover; border-radius:5px; flex-shrink:0; }
        .watchlist-price { font-family:'Orbitron',sans-serif; font-size:1rem; font-weight:700; }
        .watchlist-trend-up { color:var(--green); }
        .watchlist-trend-down { color:var(--red); }
        .watchlist-trend-flat { color:var(--text3); }
        .wl-badge { padding:3px 8px; border-radius:5px; font-size:.7rem; font-weight:700; }

        .inv-game-pick-btn.active { background: rgba(0,229,255,.12); border-color: rgba(0,229,255,.4); color: var(--cyan); }
        .inv-card:hover { border-color: rgba(255,215,64,.3); cursor: pointer; }

        .hidden { display: none !important; }

        .ach-row { display: flex; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; }
        .ach-bar-wrap { height: 12px; background: rgba(255,255,255,.07); border-radius: 99px; overflow: hidden; margin: 12px 0; position: relative; }
        .ach-bar { height: 100%; background: linear-gradient(90deg, var(--orange), var(--gold)); border-radius: 99px; transition: width .8s ease; }
        .ach-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 8px; max-height: 320px; overflow-y: auto; }
        .ach-item { display: flex; gap: 10px; align-items: center; padding: 10px 12px; background: rgba(0,0,0,.25); border-radius: 8px; border: 1px solid var(--border); }
        .ach-item.achieved { border-color: rgba(255,215,64,.3); background: rgba(255,215,64,.04); }
        .ach-icon { font-size: 1.4rem; flex-shrink: 0; }
        .ach-name { font-size: .82rem; font-weight: 700; color: var(--text); }
        .ach-desc { font-size: .72rem; color: var(--text3); margin-top: 2px; }
        .ach-date { font-size: .68rem; color: var(--gold); margin-top: 2px; }

        @@media (max-width: 600px) { .nav { padding: 0 16px; } .page { padding: 18px 14px; } }

        .roi-item { display:flex; gap:10px; align-items:center; padding:10px 12px; background:rgba(0,0,0,.25); border-radius:8px; border:1px solid var(--border); }
        .roi-item img { width:60px; height:34px; object-fit:cover; border-radius:4px; flex-shrink:0; }
        .roi-badge { font-family:'Orbitron',sans-serif; font-size:.85rem; font-weight:700; padding:4px 10px; border-radius:6px; flex-shrink:0; min-width:70px; text-align:center; }
        .roi-best { background:rgba(0,230,118,.15); color:var(--green); border:1px solid rgba(0,230,118,.3); }
        .roi-ok { background:rgba(255,215,64,.1); color:var(--gold); border:1px solid rgba(255,215,64,.2); }
        .roi-bad { background:rgba(255,23,68,.1); color:var(--red); border:1px solid rgba(255,23,68,.2); }
        .roi-name { font-size:.85rem; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
        .roi-detail { font-size:.72rem; color:var(--text3); }

        .lb-item { display:flex; gap:12px; align-items:center; padding:16px 14px; background:rgba(0,0,0,.25); border-radius:10px; border:1px solid var(--border); position:relative; overflow:hidden; margin-bottom:8px; }
        .lb-item.me { border-color:rgba(0,229,255,.4); background:rgba(0,229,255,.05); }
        .lb-rank { font-family:'Orbitron',sans-serif; font-size:1.1rem; font-weight:900; width:36px; text-align:center; flex-shrink:0; }
        .lb-rank.r1 { color:var(--gold); }
        .lb-rank.r2 { color:#aaa; }
        .lb-rank.r3 { color:#cd7f32; }
        .lb-avatar { width:44px; height:44px; border-radius:5px; flex-shrink:0; border:1px solid var(--border); }
        .lb-name { font-size:.9rem; font-weight:700; }
        .lb-stats { display:flex; gap:12px; flex-wrap:wrap; margin-top:3px; }
        .lb-stat { font-size:.72rem; color:var(--text2); }
        .lb-bar { position:absolute; bottom:0; left:0; height:3px; background:linear-gradient(90deg,var(--cyan),var(--orange)); }

        .tracker-card { background:var(--bg3); border:1px solid var(--border); border-radius:12px; padding:14px; }
        .tracker-name { font-size:.85rem; font-weight:700; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; margin-bottom:8px; }
        .tracker-prices { display:flex; gap:12px; flex-wrap:wrap; margin-bottom:10px; }
        .tp { text-align:center; }
        .tp-val { font-family:'Orbitron',sans-serif; font-size:.88rem; font-weight:700; }
        .tp-lbl { font-size:.65rem; color:var(--text3); text-transform:uppercase; letter-spacing:.5px; }
        .tracker-chart-wrap { height:80px; }
        .trend-up { color:var(--green); }
        .trend-down { color:var(--red); }
        .trend-flat { color:var(--text3); }

        .country-row { display:flex; gap:10px; align-items:center; padding:6px 10px; background:rgba(0,0,0,.2); border-radius:6px; }
        .country-bar-bg { flex:1; height:8px; background:rgba(255,255,255,.07); border-radius:99px; overflow:hidden; }
        .country-bar-fill { height:100%; background:linear-gradient(90deg,var(--cyan),var(--purple)); border-radius:99px; }
        .country-name { font-size:.82rem; font-weight:600; width:80px; flex-shrink:0; }
        .country-count { font-size:.78rem; color:var(--gold); font-weight:700; width:30px; flex-shrink:0; text-align:right; }

        .connection-status {
            position: fixed; bottom: 20px; right: 20px;
            padding: 8px 16px; border-radius: 30px;
            font-size: .8rem; font-weight: 600; z-index: 1000;
            backdrop-filter: blur(10px); border: 1px solid;
            display: flex; align-items: center; gap: 8px;
            transition: all .3s;
        }
        .status-connected { background: rgba(0,230,118,.15); color: var(--green); border-color: rgba(0,230,118,.3); }
        .status-disconnected { background: rgba(255,23,68,.15); color: var(--red); border-color: rgba(255,23,68,.3); }
        .status-connecting { background: rgba(255,215,64,.15); color: var(--gold); border-color: rgba(255,215,64,.3); }
        .status-dot {
            width: 10px; height: 10px; border-radius: 50%;
            display: inline-block;
        }
        .dot-connected { background: var(--green); box-shadow: 0 0 10px var(--green); }
        .dot-disconnected { background: var(--red); box-shadow: 0 0 10px var(--red); }
        .dot-connecting { background: var(--gold); box-shadow: 0 0 10px var(--gold); animation: pulse 1s infinite; }
        @@keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.4; } }
    </style>
</head>
<body>

<nav class="nav">
    <div class="nav-brand">⚡ STEAMVALUE</div>
    <div class="nav-links">
        <a href="/" class="nav-link active">Calculadora</a>
        <a href="/Home/Friends" class="nav-link" id="navFriendsLink">Amigos</a>
    </div>
</nav>

<div class="page">
    <!-- Hero -->
    <div class="hero">
        <div class="hero-badge">🔥 Calculadora de Conta Steam</div>
        <h1>Steam Value Calculator</h1>
        <p>Descubra o valor real da sua conta — jogos, inventários, conquistas e muito mais</p>
    </div>

    <!-- Main Calculator Card -->
    <div class="card" style="margin-bottom:24px">
        <div class="card-body">
            <div class="form-section">
                <span class="field-label">🔗 URL do Perfil Steam</span>
                <div class="input-row">
                    <input type="text" class="steam-input" id="profileUrl"
                           placeholder="steamcommunity.com/id/seu-perfil  ou  /profiles/76561198...">
                    <button class="btn btn-primary" id="btnCalc">
                        <div class="spinner hidden" id="btnSpinner"></div>
                        <span id="btnText">Calcular</span>
                    </button>
                </div>
                <div class="checkbox-row">
                    <label class="check-item">
                        <input type="checkbox" id="calcGames" checked>
                        <span>🎮 Calcular jogos</span>
                    </label>
                </div>
                <!-- Inventory game selector (shown after games are loaded) -->
                <div id="invGameSelectorWrap" style="display:none;margin-top:14px;background:rgba(0,0,0,.3);border:1px solid var(--border);border-radius:10px;padding:14px">
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;flex-wrap:wrap;gap:8px">
                        <span class="field-label" style="margin:0">📦 Buscar Inventário — Selecione um jogo</span>
                        <span style="font-size:.75rem;color:var(--text3)">Busca somente o jogo selecionado</span>
                    </div>
                    <div id="invGameList" style="display:flex;gap:8px;flex-wrap:wrap;"></div>
                    <div id="invGameLoadingMsg" style="display:none;margin-top:10px;font-size:.82rem;color:var(--text2);font-style:italic"></div>
                </div>
            </div>

            <div class="action-bar">
                <button class="btn btn-ghost btn-sm" id="btnProfile">👤 Perfil</button>
                <button class="btn btn-ghost btn-sm" id="btnWishlist">💜 Wishlist</button>
                <button class="btn btn-ghost btn-sm" id="btnWishlistAnalysis">📊 Análise Wishlist</button>
                <button class="btn btn-ghost btn-sm" id="btnBadges">🏆 Badges</button>
                <button class="btn btn-ghost btn-sm" id="btnPlaytime">⏱ Analytics</button>
                <button class="btn btn-ghost btn-sm" id="btnCompare">⚔️ Comparar</button>
                <button class="btn btn-ghost btn-sm" id="btnLivePlayers">🌐 Jogadores Live</button>
                <button class="btn btn-ghost btn-sm" id="btnHistory">📈 Histórico</button>
                <button class="btn btn-ghost btn-sm" id="btnCountries">🌍 Países</button>
                <button class="btn btn-ghost btn-sm" id="btnROI">💡 ROI</button>
                <button class="btn btn-ghost btn-sm" id="btnScout">🔭 Scout</button>
                <button class="btn btn-ghost btn-sm" id="btnLeaderboard">🏅 Leaderboard</button>
                <button class="btn btn-ghost btn-sm" id="btnTradeTracker">📉 Trade Tracker</button>
                <button class="btn btn-ghost btn-sm" id="btnGamerDna">🧬 Gamer DNA</button>
                <button class="btn btn-ghost btn-sm" id="btnActivityPatterns">🕐 Padrões Amigos</button>
                <button class="btn btn-ghost btn-sm" id="btnFreeGames">🎁 Jogos Grátis</button>
                <button class="btn btn-ghost btn-sm" id="btnGameNews">📰 Notícias</button>
                <button class="btn btn-ghost btn-sm" id="btnBacklog">🎒 Backlog</button>
                <button class="btn btn-ghost btn-sm" id="btnTopRated">⭐ Recomendados</button>
                <button class="btn btn-ghost btn-sm" id="btnExport">⬇ CSV</button>
                <a class="btn btn-orange btn-sm" id="btnFriends" href="#">👥 Amigos</a>
            </div>

            <div class="progress-wrap" id="progressWrap">
                <div class="progress-meta">
                    <span class="progress-label">Processando</span>
                    <span class="progress-pct" id="progressPct">0%</span>
                </div>
                <div class="progress-bar-bg">
                    <div class="progress-bar-fill" id="progressBar"></div>
                </div>
                <div class="progress-msg" id="progressMsg">Iniciando...</div>
            </div>

            <div id="errorBox"></div>
        </div>
    </div>

    <!-- Profile Panel -->
    <div class="profile-panel" id="profilePanel">
        <div class="section-head">
            <span class="section-title">👤 Perfil Steam</span>
            <a id="pSteamLink" href="#" target="_blank" style="font-size:.82rem;color:var(--cyan);text-decoration:none">↗ Ver no Steam</a>
        </div>
        <div class="profile-header">
            <img src="" alt="Avatar" class="profile-avatar" id="pAvatar">
            <div style="flex:1">
                <div class="profile-name" id="pName"></div>
                <div id="pStatus" style="font-size:.85rem;color:var(--text2);margin-top:4px"></div>
                <div class="profile-chips" id="pChips"></div>
            </div>
        </div>
        <div class="recent-games-strip" id="pRecentGames"></div>
    </div>

    <!-- Stats Strip -->
    <div class="stats-grid hidden" id="statsGrid">
        <div class="stat-card" data-icon="🎮">
            <div class="stat-label">Total de Jogos</div>
            <div class="stat-value stat-cyan" id="statGamesCount">0</div>
        </div>
        <div class="stat-card" data-icon="💰">
            <div class="stat-label">Valor dos Jogos</div>
            <div class="stat-value stat-green" id="statGamesVal">R$ 0</div>
        </div>
        <div class="stat-card" data-icon="📦">
            <div class="stat-label">Itens Inventário</div>
            <div class="stat-value stat-cyan" id="statInvCount">0</div>
        </div>
        <div class="stat-card" data-icon="💎">
            <div class="stat-label">Valor Inventário</div>
            <div class="stat-value stat-gold" id="statInvVal">R$ 0</div>
        </div>
        <div class="stat-card" data-icon="⏱">
            <div class="stat-label">Horas Jogadas</div>
            <div class="stat-value stat-orange" id="statPlaytime">0h</div>
        </div>
    </div>

    <!-- Total Box -->
    <div class="total-box hidden" id="totalBox">
        <div class="total-label">💰 Valor Total Estimado da Conta Steam</div>
        <div class="total-value" id="totalVal">R$ 0,00</div>
    </div>

    <!-- Feature Tabs -->
    <div class="card hidden" id="featurePanel" style="margin-bottom:22px">
        <div class="card-body">
            <div class="feature-tabs" id="featureTabs">
                <button class="ftab active" data-tab="games">🎮 Jogos</button>
                <button class="ftab" data-tab="inventory">📦 Inventário</button>
                <button class="ftab" data-tab="wishlist">💜 Wishlist</button>
                <button class="ftab" data-tab="wishlistanalysis">📊 Análise Wishlist</button>
                <button class="ftab" data-tab="badges">🏆 Badges</button>
                <button class="ftab" data-tab="playtime">⏱ Analytics</button>
                <button class="ftab" data-tab="compare">⚔️ Comparar</button>
                <button class="ftab" data-tab="liveplayers">🌐 Live Players</button>
                <button class="ftab" data-tab="achievements">🥇 Conquistas</button>
                <button class="ftab" data-tab="history">📈 Histórico</button>
                <button class="ftab" data-tab="roi">💡 ROI</button>
                <button class="ftab" data-tab="scout">🔭 Scout</button>
                <button class="ftab" data-tab="leaderboard">🏅 Leaderboard</button>
                <button class="ftab" data-tab="tradetracker">📉 Trade Tracker</button>
                <button class="ftab" data-tab="countries">🌍 Países</button>
                <button class="ftab" data-tab="watchlist">👁 Watchlist</button>
                <button class="ftab" data-tab="gamerdna">🧬 Gamer DNA</button>
                <button class="ftab" data-tab="activitypatterns">🕐 Padrões Amigos</button>
                <button class="ftab" data-tab="freegames">🎁 Jogos Grátis</button>
                <button class="ftab" data-tab="gamenews">📰 Notícias</button>
                <button class="ftab" data-tab="backlog">🎒 Backlog</button>
                <button class="ftab" data-tab="toprated">⭐ Recomendados</button>
            </div>

            <!-- Games Tab -->
            <div class="ftab-panel active" id="tab-games">
                <div class="section-head">
                    <span class="section-title">Biblioteca</span>
                    <span class="section-badge" id="gamesBadge">0 jogos</span>
                </div>
                <div class="filter-row">
                    <select class="select-s" id="sortGames">
                        <option value="price_desc">💰 Maior valor</option>
                        <option value="price_asc">💰 Menor valor</option>
                        <option value="playtime_desc">⏱ Mais jogado</option>
                        <option value="metacritic_desc">⭐ Metacritic</option>
                        <option value="name_asc">🔤 Nome A-Z</option>
                    </select>
                    <input type="number" class="num-s" id="filterMaxVal" placeholder="Valor máx. R$" value="1000" style="width:140px">
                    <input type="text" class="text-s" id="filterSearch" placeholder="🔍 Buscar jogo..." style="width:180px">
                    <button class="btn btn-ghost btn-sm" onclick="applyGamesFilter()">Aplicar</button>
                </div>
                <div class="games-grid" id="gamesGrid"></div>
            </div>

            <!-- Inventory Tab -->
            <div class="ftab-panel" id="tab-inventory">
                <div class="section-head">
                    <span class="section-title">Inventário</span>
                    <div style="display:flex;gap:8px;align-items:center">
                        <span class="section-badge" id="invBadge">0 itens</span>
                        <button class="btn btn-ghost btn-sm" id="btnPriceAllItems" style="display:none" onclick="startLazyPricing()">
                            💰 Precificar itens
                        </button>
                    </div>
                </div>
                <!-- Game selector for inventory -->
                <div id="invGamePickerPanel" style="background:rgba(0,0,0,.3);border:1px solid var(--border);border-radius:10px;padding:16px;margin-bottom:14px">
                    <div style="font-size:.82rem;color:var(--text2);margin-bottom:12px;font-weight:600">🎮 Selecione o jogo para buscar o inventário:</div>
                    <div id="invGamePickerList" style="display:flex;gap:8px;flex-wrap:wrap;">
                        <div style="color:var(--text3);font-size:.82rem;font-style:italic">Calcule sua conta primeiro para ver os jogos disponíveis</div>
                    </div>
                    <div id="invLoadingGame" style="display:none;margin-top:10px;font-size:.82rem;color:var(--cyan);font-style:italic">⏳ Buscando inventário...</div>
                </div>
                <!-- CS2 Wear Filters (only shown when CS2 is active) -->
                <div id="cs2WearFilters" style="display:none;background:rgba(0,229,255,.04);border:1px solid rgba(0,229,255,.15);border-radius:10px;padding:12px;margin-bottom:12px">
                    <div style="font-size:.75rem;color:var(--text2);font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-bottom:10px">🎯 Filtrar por Desgaste</div>
                    <div style="display:flex;gap:12px;flex-wrap:wrap">
                        <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:.85rem">
                            <input type="checkbox" id="wearFN" checked style="accent-color:var(--cyan);width:15px;height:15px">
                            <span style="color:#b8f5d8">✦ Nova de Fábrica</span>
                        </label>
                        <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:.85rem">
                            <input type="checkbox" id="wearMW" checked style="accent-color:var(--cyan);width:15px;height:15px">
                            <span style="color:#7ecef4">Pouco Usada</span>
                        </label>
                        <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:.85rem">
                            <input type="checkbox" id="wearFT" checked style="accent-color:var(--cyan);width:15px;height:15px">
                            <span style="color:#cdd9e5">Testada em Campo</span>
                        </label>
                        <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:.85rem">
                            <input type="checkbox" id="wearWW" checked style="accent-color:var(--cyan);width:15px;height:15px">
                            <span style="color:#8fadc8">Bem Usada</span>
                        </label>
                        <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:.85rem">
                            <input type="checkbox" id="wearBS" checked style="accent-color:var(--cyan);width:15px;height:15px">
                            <span style="color:#546e7a">Lixo de Guerra</span>
                        </label>
                        <button class="btn btn-ghost btn-sm" onclick="toggleAllWear()">Alternar Todos</button>
                    </div>
                </div>
                <!-- Filters -->
                <div class="inv-filter-row" id="invFilterRow" style="display:none">
                    <input type="text" class="text-s" id="invSearch" placeholder="🔍 Buscar item..." style="width:180px" oninput="renderInvGrid()">
                    <select class="select-s" id="invRarityFilter" onchange="renderInvGrid()">
                        <option value="">Todas as raridades</option>
                    </select>
                    <select class="select-s" id="invSortMode" onchange="renderInvGrid()">
                        <option value="price_desc">💰 Maior valor</option>
                        <option value="price_asc">Menor valor</option>
                        <option value="count_desc">📦 Mais itens</option>
                        <option value="name_asc">🔤 Nome A-Z</option>
                    </select>
                    <div id="priceQueueInfo" class="price-queue-info" style="display:none"></div>
                </div>
                <!-- Rarity chart -->
                <div id="invRarityChart" style="display:none">
                    <div class="inv-rarity-breakdown" id="invRarityChips"></div>
                    <div class="inv-chart-wrap"><canvas id="rarityCanvas"></canvas></div>
                </div>
                <div class="inv-tabs" id="invTabs"></div>
                <div class="inv-grid" id="invGrid"></div>
                <div id="invEmpty" class="hidden" style="color:var(--text3);font-size:.9rem;padding:20px 0;text-align:center">
                    Nenhum item encontrado ou inventário privado
                </div>
            </div>

            <!-- Wishlist Tab -->
            <div class="ftab-panel" id="tab-wishlist">
                <div class="section-head">
                    <span class="section-title">Wishlist</span>
                    <span class="section-badge" id="wishBadge">0</span>
                </div>
                <div class="wish-list" id="wishList"></div>
            </div>

            <!-- Badges Tab -->
            <div class="ftab-panel" id="tab-badges">
                <div class="section-head"><span class="section-title">Badges & XP</span></div>
                <div class="badge-stats" id="badgeStats"></div>
            </div>

            <!-- Playtime Analytics Tab -->
            <div class="ftab-panel" id="tab-playtime">
                <div class="section-head"><span class="section-title">Analytics de Jogatina</span></div>
                <div class="playtime-stats" id="ptStats"></div>
                <div id="ptBar" style="margin-bottom:14px">
                    <div style="display:flex;justify-content:space-between;font-size:.78rem;color:var(--text2);margin-bottom:4px">
                        <span>Jogos jogados</span><span id="ptBarPct"></span>
                    </div>
                    <div class="pt-bar-wrap"><div class="pt-bar" id="ptBarFill" style="width:0%"></div></div>
                </div>
                <div class="section-head" style="margin-top:16px"><span class="section-title">🏆 Top 10 Mais Jogados</span></div>
                <div class="most-played-list" id="mostPlayedList"></div>
            </div>

            <!-- Compare Tab -->
            <div class="ftab-panel" id="tab-compare">
                <div class="section-head"><span class="section-title">Comparar Perfis</span></div>
                <div class="compare-row">
