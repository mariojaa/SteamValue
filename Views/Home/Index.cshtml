// ── History Chart ──
function updateHistChart() {
    if (!snapshotData.length) return;
    showFeaturePanel('history');
    const ctx = document.getElementById('histChart').getContext('2d');
    const labels = snapshotData.map(s => s.time);
    const values = snapshotData.map(s => s.total);

    if (histChart) { histChart.data.labels = labels; histChart.data.datasets[0].data = values; histChart.update(); return; }

    histChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels,
            datasets: [{
                label: 'Valor total (R$)', data: values,
                borderColor: '#00e5ff', backgroundColor: 'rgba(0,229,255,.08)',
                tension: .4, fill: true,
                pointBackgroundColor: '#ff5722', pointRadius: 5, pointHoverRadius: 8
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { labels: { color: '#8fadc8', font: { family: 'Exo 2' } } } },
            scales: {
                x: { ticks: { color: '#8fadc8' }, grid: { color: 'rgba(255,255,255,.04)' } },
                y: { ticks: { color: '#8fadc8', callback: v => 'R$ ' + v.toLocaleString('pt-BR') }, grid: { color: 'rgba(255,255,255,.04)' } }
            }
        }
    });
}

// ── CSV Export ──
function exportCSV() {
    const rows = ['Tipo,Nome,Preço (R$),Horas,Gênero,Metacritic'];
    allGames.forEach(g => rows.push(`"Jogo","${g.name?.replace(/"/g,'""')}","${g.price.toFixed(2)}","${Math.round(g.playtimeMinutes/60)}","${g.genre||''}","${g.metacritic||''}"`));
    Object.entries(inventories).forEach(([game, {items}]) =>
        items.forEach(it => rows.push(`"Inventário ${game}","${it.name?.replace(/"/g,'""')}","${it.price.toFixed(2)}","","",""`)));

    const blob = new Blob(['\ufeff' + rows.join('\n')], { type: 'text/csv;charset=utf-8;' });
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob);
    a.download = `steam_value_${new Date().toISOString().slice(0,10)}.csv`;
    a.click();
}

// ── Helpers ──
function fmtBRL(v) { return 'R$ ' + Number(v||0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }); }
function fmtTime(m) { if (!m) return '0min'; return m < 60 ? m+'min' : Math.round(m/60)+'h'; }
function showError(msg) { document.getElementById('errorBox').innerHTML = `<div class="error-box">⚠ ${msg}</div>`; }

// ── Init ──
buildConnection();
try { const s = localStorage.getItem('steamProfileUrl'); if (s) document.getElementById('profileUrl').value = s; } catch {}
</script>
