// ── Profile Comparison ──
function renderComparison(data) {
    const stats = [
        {label:'Jogos',v1:data.gamesCount1,v2:data.gamesCount2},
        {label:'Nível Steam',v1:data.level1,v2:data.level2},
        {label:'Badges',v1:data.badgeCount1,v2:data.badgeCount2},
        {label:'XP Total',v1:(data.totalXp1||0).toLocaleString('pt-BR'),v2:(data.totalXp2||0).toLocaleString('pt-BR'),raw1:data.totalXp1,raw2:data.totalXp2},
        {label:'Horas Jogadas',v1:(data.totalHours1||0)+'h',v2:(data.totalHours2||0)+'h',raw1:data.totalHours1,raw2:data.totalHours2},
        {label:'Jogos em Comum',v1:data.commonGamesCount,v2:data.commonGamesCount},
    ];
    const buildStats = (num) => stats.map(s => {
        const v = num===1?s.v1:s.v2;
        const r1 = s.raw1!==undefined?s.raw1:(typeof s.v1==='number'?s.v1:0);
        const r2 = s.raw2!==undefined?s.raw2:(typeof s.v2==='number'?s.v2:0);
        const isBetter = num===1?r1>r2:r2>r1;
        return `<div class="cmp-stat"><span>${s.label}</span><span class="cmp-val ${isBetter?'better':''}">${v}</span></div>`;
    }).join('');
    document.getElementById('compareResult').innerHTML = `
        <div class="compare-grid">
            <div class="compare-col ${data.gamesCount1>data.gamesCount2?'winner':''}">
                <img class="cmp-avatar" src="${data.avatar1||''}" onerror="this.style.display='none'">
                <div class="cmp-name">${data.name1||'Perfil 1'}</div>${buildStats(1)}
            </div>
            <div class="compare-vs"><div style="font-family:'Orbitron',sans-serif;font-size:1.5rem;font-weight:900;color:var(--orange)">VS</div></div>
            <div class="compare-col ${data.gamesCount2>data.gamesCount1?'winner':''}">
                <img class="cmp-avatar" src="${data.avatar2||''}" onerror="this.style.display='none'">
                <div class="cmp-name">${data.name2||'Perfil 2'}</div>${buildStats(2)}
            </div>
        </div>
        ${data.commonGames&&data.commonGames.length?`<div style="margin-top:20px"><div class="section-head"><span class="section-title">🎮 Jogos em comum (${data.commonGamesCount})</span></div>
        <div style="display:flex;gap:10px;flex-wrap:wrap">${data.commonGames.slice(0,12).map(g=>`<div title="${g.name||g.Name}" style="width:80px;cursor:pointer" onclick="window.open('https://store.steampowered.com/app/${g.appId||g.AppId}','_blank')"><img src="${g.imageUrl||g.IconUrl||''}" style="width:80px;height:40px;object-fit:cover;border-radius:4px;display:block" onerror="this.src='https://cdn.akamai.steamstatic.com/steam/apps/${g.appId||g.AppId}/header.jpg'"><div style="font-size:.65rem;color:var(--text2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-top:3px">${g.name||g.Name}</div></div>`).join('')}</div></div>`:''}`;
}

