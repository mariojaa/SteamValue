function renderFreeGames(data) {
    const grid = document.getElementById('freeGamesGrid');
    if (!data||!data.length) { grid.innerHTML='<p style="color:var(--text3);padding:14px">Nenhum jogo gratuito encontrado no momento.</p>'; return; }
    grid.innerHTML = data.map(g=>`<div class="game-card" onclick="window.open('https://store.steampowered.com/app/${g.appId}','_blank')">
        <img src="${g.imageUrl||''}" onerror="this.src='https://cdn.akamai.steamstatic.com/steam/apps/${g.appId}/header.jpg'">
        <div class="game-card-info">
            <div class="game-name" title="${g.name||''}">${g.name||'App '+g.appId}</div>
            <div class="game-price" style="color:var(--green)">🎁 GRÁTIS</div>
            ${g.originalPrice>0?`<div style="font-size:.7rem;color:var(--text3);text-decoration:line-through">${fmtBRL(g.originalPrice)}</div>`:''}
            <div class="game-meta" style="color:var(--cyan)">${g.type||(g.isFreeToPlay?'Free to Play':'Promoção')}</div>
            ${g.endDate?`<div style="font-size:.65rem;color:var(--orange)">Até: ${g.endDate}</div>`:''}
        </div>
    </div>`).join('');
}

function refreshFreeGames() {
    showLoading('freeGamesGrid','Buscando jogos grátis...');
    showProgress('Buscando jogos grátis...');
    ensureConnected(() => connection.invoke('GetFreeGamesToday').catch(e => { showError(e.message); document.getElementById('progressWrap').classList.remove('active'); }));
}

// ── Game News ──
function renderGameNews(data) {
    const el = document.getElementById('gameNewsResult');
    if (!data||!data.length) { el.innerHTML='<p style="color:var(--text3);padding:14px">Nenhuma notícia encontrada. Certifique-se de ter jogos com tempo jogado.</p>'; return; }
    const byGame = {};
    data.forEach(n => { if (!byGame[n.appId]) byGame[n.appId]={gameName:n.gameName,gameImage:n.gameImage,items:[]}; byGame[n.appId].items.push(n); });
    el.innerHTML = Object.entries(byGame).map(([appId,g])=>`
        <div style="margin-bottom:20px">
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;padding-bottom:8px;border-bottom:1px solid var(--border)">
                <img src="${g.gameImage||''}" style="width:40px;height:40px;border-radius:6px;object-fit:cover" onerror="this.src='https://cdn.akamai.steamstatic.com/steam/apps/${appId}/capsule_sm_120.jpg'">
                <div style="font-family:'Orbitron',sans-serif;font-size:.85rem;font-weight:700">${g.gameName}</div>
            </div>
            <div style="display:flex;flex-direction:column;gap:8px">${g.items.map(n=>`<a href="${n.url}" target="_blank" style="display:block;padding:12px 14px;background:rgba(0,0,0,.25);border:1px solid var(--border);border-radius:8px;text-decoration:none" onmouseover="this.style.borderColor='rgba(0,229,255,.3)'" onmouseout="this.style.borderColor='var(--border)'">
                <div style="font-size:.88rem;font-weight:700;color:var(--text);margin-bottom:4px">${n.title}</div>
                <div style="font-size:.75rem;color:var(--text3);margin-bottom:6px">${n.feedName||''}${n.author?' · '+n.author:''} · ${n.date?new Date(n.date*1000).toLocaleDateString('pt-BR'):''}</div>
                ${n.contents?`<div style="font-size:.78rem;color:var(--text2);line-height:1.5">${n.contents}...</div>`:''}
            </a>`).join('')}</div>
        </div>`).join('');
}

// ── Backlog Analysis ──
function renderBacklogAnalysis(data) {
    const el = document.getElementById('backlogResult');
    if (!data||data.totalUnplayed===0) { el.innerHTML='<p style="color:var(--green);padding:14px">🎉 Você jogou todos os seus jogos!</p>'; document.getElementById('backlogBadge').textContent='0 jogos'; return; }
    document.getElementById('backlogBadge').textContent = data.totalUnplayed + ' jogos';
    const maxGenreCount = Math.max(...(data.genreBreakdown||[{count:1}]).map(g=>g.count),1);
    el.innerHTML = `
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:20px">
            <div class="badge-stat"><div class="badge-stat-val" style="color:var(--red)">${data.totalUnplayed}</div><div class="badge-stat-lbl">Nunca Jogados</div></div>
            <div class="badge-stat"><div class="badge-stat-val" style="color:var(--gold)">${fmtBRL(data.backlogDebt)}</div><div class="badge-stat-lbl">Dinheiro "Perdido"</div></div>
            <div class="badge-stat"><div class="badge-stat-val" style="color:var(--orange)">${fmtBRL(data.averagePriceUnplayed)}</div><div class="badge-stat-lbl">Preço Médio</div></div>
        </div>
        ${(data.genreBreakdown||[]).length?`<div style="margin-bottom:20px"><div style="font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--text2);margin-bottom:10px">🎭 Gêneros no backlog</div>${(data.genreBreakdown||[]).map(g=>`<div style="display:flex;align-items:center;gap:8px;padding:4px 0"><div style="font-size:.82rem;color:var(--text2);width:120px;flex-shrink:0">${g.genre}</div><div style="flex:1;height:6px;background:rgba(255,255,255,.07);border-radius:99px;overflow:hidden"><div style="height:100%;width:${Math.round(g.count/maxGenreCount*100)}%;background:linear-gradient(90deg,var(--cyan),var(--purple));border-radius:99px"></div></div><div style="font-size:.75rem;color:var(--gold);font-weight:700;width:24px;text-align:right">${g.count}</div></div>`).join('')}</div>`:''}
        <div style="font-size:.8rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--text2);margin-bottom:12px">⭐ Jogar primeiro</div>
        <div class="games-grid">${(data.topPriorityGames||[]).map(g=>{const mc=g.metacritic>0?`<span class="metacritic-badge ${g.metacritic>=75?'mc-good':g.metacritic>=50?'mc-ok':'mc-bad'}">${g.metacritic}</span>`:''; return `<div class="game-card" onclick="window.open('https://store.steampowered.com/app/${g.appId}','_blank')"><img src="${g.imageUrl||''}" onerror="this.src='https://cdn.akamai.steamstatic.com/steam/apps/${g.appId}/header.jpg'"><div class="game-card-info"><div class="game-name" title="${g.name}">${g.name}</div><div class="game-price">${g.price>0?fmtBRL(g.price):'Grátis'}</div><div class="game-meta">${mc}${g.genre||''}</div></div></div>`; }).join('')}</div>`;
}

// ── Top Rated Unowned Tab ──
function renderTopRatedUnowned(data) {
    const grid = document.getElementById('topRatedGrid');
    if (!data||!data.length) { grid.innerHTML='<p style="color:var(--text3);padding:14px">Nenhuma recomendação encontrada. Tente aumentar o preço máximo.</p>'; return; }
    grid.innerHTML = data.map(g=>{
        const mc=g.metacritic>0?`<span class="metacritic-badge ${g.metacritic>=75?'mc-good':g.metacritic>=50?'mc-ok':'mc-bad'}">${g.metacritic}</span>`:'';
        const score=g.reviewScore>0?`<span style="font-size:.68rem;color:var(--cyan)">⭐ ${g.reviewScore.toFixed(1)}</span>`:'';
        return `<div class="game-card" onclick="window.open('https://store.steampowered.com/app/${g.appId}','_blank')">
            <img src="${g.imageUrl||''}" onerror="this.src='https://cdn.akamai.steamstatic.com/steam/apps/${g.appId}/header.jpg'">
            <div class="game-card-info">
                <div class="game-name" title="${g.name}">${g.name}</div>
                <div class="game-price">${g.isFree?'🎁 Grátis':fmtBRL(g.price)}</div>
                <div class="game-meta">${mc}${score}</div>
            </div>
        </div>`;
    }).join('');
}

function loadTopRatedUnowned() {
    const url = getUrl(); if (!url) return;
    const maxPrice = parseFloat(document.getElementById('maxPriceFilter').value)||1000;
    showProgress('Buscando recomendações...');
    showLoading('topRatedGrid', 'Buscando jogos bem avaliados...');
    showFeaturePanel('toprated');
    ensureConnected(() => connection.invoke('GetTopRatedUnownedGames', url, maxPrice)
        .catch(e => { showError(e.message); document.getElementById('progressWrap').classList.remove('active'); }));
}
</script>
</body>
</html>
