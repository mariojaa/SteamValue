                    </div>
                    <!-- CS2 Wear Filters -->
                    <div id="friendCs2WearFilters" style="display:none;background:rgba(0,229,255,.04);border:1px solid rgba(0,229,255,.15);border-radius:10px;padding:12px;margin-bottom:12px">
                        <div style="font-size:.75rem;color:var(--text2);font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-bottom:10px">🎯 Filtrar por Desgaste</div>
                        <div style="display:flex;gap:12px;flex-wrap:wrap">
                            <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:.85rem">
                                <input type="checkbox" id="fWearFN" checked style="accent-color:var(--cyan);width:15px;height:15px">
                                <span style="color:#b8f5d8">✦ Nova de Fábrica</span>
                            </label>
                            <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:.85rem">
                                <input type="checkbox" id="fWearMW" checked style="accent-color:var(--cyan);width:15px;height:15px">
                                <span style="color:#7ecef4">Pouco Usada</span>
                            </label>
                            <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:.85rem">
                                <input type="checkbox" id="fWearFT" checked style="accent-color:var(--cyan);width:15px;height:15px">
                                <span style="color:#cdd9e5">Testada em Campo</span>
                            </label>
                            <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:.85rem">
                                <input type="checkbox" id="fWearWW" checked style="accent-color:var(--cyan);width:15px;height:15px">
                                <span style="color:#8fadc8">Bem Usada</span>
                            </label>
                            <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:.85rem">
                                <input type="checkbox" id="fWearBS" checked style="accent-color:var(--cyan);width:15px;height:15px">
