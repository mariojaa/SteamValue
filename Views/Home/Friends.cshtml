// ── Activity Patterns ─────────────────────────────────────────────────────
function loadActivityPatterns() {
    if (!myProfileUrl) return;
    connection.invoke('GetFriendActivityPatterns', myProfileUrl);
}

function renderActivityPatterns(patterns) {
    const c = document.getElementById('activity-content');
    if (!patterns || patterns.length === 0) {
        c.innerHTML = '<div class="text-muted text-center" style="padding:30px">Sem dados de atividade</div>';
        return;
    }

    const slots = { 'Madrugador': [], 'Matutino': [], 'Vespertino': [], 'Noturno': [] };
    patterns.forEach(p => { if (slots[p.activitySlot]) slots[p.activitySlot].push(p); });

    const slotIcons = { 'Madrugador': '🌙', 'Matutino': '🌅', 'Vespertino': '☀️', 'Noturno': '🌆' };
    const slotDesc = { 'Madrugador': '00h–06h', 'Matutino': '06h–12h', 'Vespertino': '12h–18h', 'Noturno': '18h–00h' };

    const onlineNow = patterns.filter(p => p.isOnline);
    const playingNow = patterns.filter(p => p.playingGame);

    c.innerHTML = `
        ${onlineNow.length ? `<div style="background:rgba(0,230,118,.06);border:1px solid rgba(0,230,118,.2);border-radius:10px;padding:12px;margin-bottom:14px">
            <div class="sec-title" style="border:none;margin:0 0 8px;color:var(--green)">🟢 Online Agora (${onlineNow.length})</div>
            <div style="display:flex;flex-wrap:wrap;gap:8px">
                ${onlineNow.map(p => `
                    <div style="display:flex;align-items:center;gap:6px;background:var(--bg2);border-radius:6px;padding:4px 8px">
                        <img src="${p.avatar}" style="width:22px;height:22px;border-radius:3px">
                        <span style="font-size:.78rem">${escHtml(p.name)}</span>
                        ${p.playingGame ? `<span style="font-size:.68rem;color:var(--ingame)">🎮 ${escHtml(p.playingGame)}</span>` : ''}
                    </div>
                `).join('')}
            </div>
        </div>` : ''}
        <div class="slots-grid">
            ${Object.entries(slots).map(([slot, friends]) => `
                <div class="slot-card">
                    <div class="flex items-center between" style="margin-bottom:6px">
                        <div class="slot-title">${slotIcons[slot]} ${slot} <span style="font-size:.7rem;color:var(--text3)">${slotDesc[slot]}</span></div>
                        <div class="slot-count">${friends.length}</div>
                    </div>
                    <div class="slot-friends">
                        ${friends.slice(0,12).map(p => `
                            <img class="slot-avatar" src="${p.avatar}" title="${escHtml(p.name)}" 
                                onerror="this.src='https://avatars.cloudflare.steamstatic.com/fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb_full.jpg'">
                        `).join('')}
                        ${friends.length > 12 ? `<span style="font-size:.72rem;color:var(--text3);padding:4px">+${friends.length-12}</span>` : ''}
                    </div>
                </div>
            `).join('')}
        </div>
        <div class="sec-title">Lista Detalhada</div>
        <div style="display:flex;flex-direction:column;gap:6px;max-height:300px;overflow-y:auto">
            ${[...patterns].sort((a,b) => b.lastLogoffUnix-a.lastLogoffUnix).map(p => {
                const dt = p.lastLogoffUnix ? new Date(p.lastLogoffUnix*1000).toLocaleString('pt-BR') : '';
                return `<div style="display:flex;align-items:center;gap:10px;background:var(--bg2);border:1px solid var(--border);border-radius:8px;padding:8px 10px">
                    <img src="${p.avatar}" style="width:30px;height:30px;border-radius:4px">
                    <div style="flex:1;min-width:0">
                        <div style="font-size:.82rem;font-weight:600">${escHtml(p.name)}</div>
                        <div style="font-size:.72rem;color:var(--text3)">${slotIcons[p.activitySlot]} ${p.activitySlot} • ${dt}</div>
                    </div>
                    ${p.isOnline ? '<span class="profile-badge badge-online" style="flex-shrink:0">Online</span>' : ''}
                </div>`;
            }).join('')}
        </div>
    `;
}

