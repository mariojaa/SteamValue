                <!-- Tab: Inventário -->
                <div class="tab-content" id="tab-inventory">
                    <!-- Game selector for inventory -->
                    <div id="friendInvGameSelector" style="background:rgba(0,0,0,.3);border:1px solid var(--border);border-radius:10px;padding:14px;margin-bottom:14px">
