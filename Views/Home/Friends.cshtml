                    <div class="inv-total-bar">
                        <span style="font-size:.85rem;color:var(--text2)">Valor total do inventário</span>
                        <span id="inv-total" style="font-family:'Orbitron',sans-serif;font-size:1.1rem;font-weight:700;color:var(--green)">—</span>
                    </div>
                    <div id="inv-grid" class="inv-grid">
                        <div class="text-muted text-center" style="grid-column:1/-1;padding:30px">Selecione um jogo acima para ver o inventário</div>
                    </div>
                </div>

                <!-- Tab: Medalhas -->
                <div class="tab-content" id="tab-badges">
                    <div class="sec-title">Medalhas Steam</div>
                    <div id="badges-grid" class="badges-grid"></div>
                </div>

                <!-- Tab: Conquistas -->
                <div class="tab-content" id="tab-achievements">
                    <div class="ach-header">
                        <div>
                            <div class="sec-title" style="border:none;margin:0">Conquistas</div>
