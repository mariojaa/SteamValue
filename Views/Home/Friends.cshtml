// ── Achievements ──────────────────────────────────────────────────────────
function loadAchievements(appId, gameName) {
    if (!currentFriendId) return;
    switchTab('achievements');
    showProfileLoading(`Carregando conquistas: ${gameName}...`);
    // Add to game buttons
    const btns = document.getElementById('ach-game-btns');
    if (!btns.querySelector(`[data-appid="${appId}"]`)) {
        const btn = document.createElement('button');
        btn.className = 'btn btn-ghost btn-sm';
        btn.dataset.appid = appId;
        btn.textContent = gameName;
        btn.onclick = () => {
            showProfileLoading(`Carregando conquistas: ${gameName}...`);
            connection.invoke('GetAchievements', `https://steamcommunity.com/profiles/${currentFriendId}`, appId);
        };
        btns.appendChild(btn);
    }
    connection.invoke('GetAchievements', `https://steamcommunity.com/profiles/${currentFriendId}`, appId);
}

function renderAchievements(appId, total, unlocked, pct, list) {
    document.getElementById('ach-count').textContent = `${unlocked} / ${total} conquistas desbloqueadas`;
    document.getElementById('ach-fill').style.width = pct.toFixed(1) + '%';
    document.getElementById('ach-pct').textContent = pct.toFixed(1) + '%';
    const container = document.getElementById('ach-list');
    if (!list || list.length === 0) {
        container.innerHTML = '<div class="text-muted text-center" style="grid-column:1/-1;padding:20px">Sem conquistas ou perfil privado</div>';
        return;
    }
    const fallbackIcon = 'https://community.cloudflare.steamstatic.com/public/images/acquisitions/v1/games/achievements/no_achievement.png';
    container.innerHTML = list.map(a => {
        const achieved = a.Achieved ?? a.achieved ?? false;
        const name = a.Name || a.name || a.ApiName || a.apiName || '';
        const desc = a.Description || a.description || '';
        const iconUrl = a.IconUrl || a.iconUrl || fallbackIcon;
        const unlockTime = a.UnlockTime || a.unlockTime || 0;
        const dateHtml = achieved && unlockTime > 0
            ? `<div style="font-size:.68rem;color:var(--gold);margin-top:2px">🏆 ${new Date(unlockTime * 1000).toLocaleDateString('pt-BR')}</div>`
            : '';
        return `
        <div class="ach-item${achieved ? ' unlocked' : ''}">
            <img class="ach-icon"
                 src="${iconUrl}"
                 alt="${escHtml(name)}"
                 title="${escHtml(name)}"
                 onerror="this.src='${fallbackIcon}'"
                 style="${achieved ? '' : 'filter:grayscale(1);opacity:.45'}">
            <div class="ach-info">
                <div class="ach-name">${escHtml(name)}</div>
                ${desc ? `<div class="ach-desc">${escHtml(desc)}</div>` : ''}
                ${dateHtml}
            </div>
        </div>`;
    }).join('');
}

