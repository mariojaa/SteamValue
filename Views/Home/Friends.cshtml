function loadFriendInvGame(appId) {
    if (!currentFriendId) return;

    // Highlight button
    document.querySelectorAll('.friend-inv-game-btn').forEach(b => {
        b.classList.toggle('active', parseInt(b.dataset.appid) === appId);
    });

    // Show/hide CS2 filters
    document.getElementById('friendCs2WearFilters').style.display = appId === 730 ? '' : 'none';

    if (inventoryData[appId]) {
        renderInventory(appId, inventoryData[appId].items, inventoryData[appId].total);
        return;
    }
    document.getElementById('friendInvLoadingMsg').style.display = '';
    document.getElementById('friendInvLoadingMsg').textContent = `⏳ Carregando inventário ${appNames[appId]}...`;
    document.getElementById('inv-grid').innerHTML = '<div class="text-muted text-center" style="grid-column:1/-1;padding:30px">Carregando...</div>';
    connection.invoke('GetFriendInventory', currentFriendId, appId);
}

function loadInvTab(appId) {
    loadFriendInvGame(appId);
}

function toggleFriendWear() {
    const ids = ['fWearFN','fWearMW','fWearFT','fWearWW','fWearBS'];
    const anyUnchecked = ids.some(id => !document.getElementById(id).checked);
    ids.forEach(id => document.getElementById(id).checked = anyUnchecked);
    if (inventoryData[currentInvApp]) renderInventory(currentInvApp, inventoryData[currentInvApp].items, inventoryData[currentInvApp].total);
}

function renderInventory(appId, items, total) {
    currentInvApp = appId;
    document.getElementById('inv-total').textContent = `R$ ${(total||0).toFixed(2)}`;
    document.getElementById('friendInvLoadingMsg').style.display = 'none';
    hideProfileLoading();

    const container = document.getElementById('inv-grid');
    if (!items || items.length === 0) {
        container.innerHTML = '<div class="text-muted text-center" style="grid-column:1/-1;padding:30px">Inventário vazio ou privado</div>';
        return;
    }

    let filtered = [...items];

    // CS2 wear filter
    if (appId === 730) {
        const wFN = document.getElementById('fWearFN')?.checked ?? true;
        const wMW = document.getElementById('fWearMW')?.checked ?? true;
        const wFT = document.getElementById('fWearFT')?.checked ?? true;
        const wWW = document.getElementById('fWearWW')?.checked ?? true;
        const wBS = document.getElementById('fWearBS')?.checked ?? true;
        filtered = filtered.filter(it => {
            const n = (it.name||'').toLowerCase();
            if (n.includes('factory new') || n.includes('fn)')) return wFN;
            if (n.includes('minimal wear') || n.includes('mw)')) return wMW;
            if (n.includes('field-tested') || n.includes('ft)')) return wFT;
            if (n.includes('well-worn') || n.includes('ww)')) return wWW;
            if (n.includes('battle-scarred') || n.includes('bs)')) return wBS;
            return true;
        });
    }

    const sorted = [...filtered].sort((a, b) => (b.price||0) - (a.price||0));
    container.innerHTML = sorted.map(it => {
        const rarityColor = getRarityColor(it.rarity);
        const marketUrl = `https://steamcommunity.com/market/listings/${appId}/${encodeURIComponent(it.name)}`;
        const priceHtml = it.price > 0
            ? `<div class="inv-card-price">R$ ${it.price.toFixed(2)}</div>`
            : it.unitPrice === -1
                ? '<div class="inv-card-price" style="color:var(--text3)">Precificando...</div>'
                : '<div class="inv-card-price" style="color:var(--text3)">—</div>';
        return `<div class="inv-card" onclick="window.open('${marketUrl}','_blank')"
                     title="${escHtml(it.name)} — Clique para ver no mercado Steam"
                     style="cursor:pointer">
            ${it.imageUrl ? `<img class="inv-card-img" src="${it.imageUrl}" alt="" loading="lazy">` : '<div class="inv-card-img" style="background:var(--bg3)"></div>'}
            ${it.count > 1 ? `<div class="inv-card-count">×${it.count}</div>` : ''}
            ${it.rarity ? `<div class="rarity-badge" style="background:${rarityColor}20;color:${rarityColor};border:1px solid ${rarityColor}50">${it.rarity}</div>` : ''}
            <div class="inv-card-body">
                <div class="inv-card-name" title="${escHtml(it.name)}">${escHtml(it.name)}</div>
                ${priceHtml}
            </div>
        </div>`;
    }).join('');
}

function getRarityColor(r) {
    if (!r) return '#546e7a';
    const map = { 'Consumer Grade': '#b0c3d9', 'Industrial Grade': '#5e98d9', 'Mil-Spec': '#4b69ff',
        'Restricted': '#8847ff', 'Classified': '#d32ce6', 'Covert': '#eb4b4b',
        'Contraband': '#e4ae39', 'Base Grade': '#b0c3d9', 'Uncommon': '#5e98d9',
        'Rare': '#4b69ff', 'Mythical': '#8847ff', 'Legendary': '#d32ce6',
        'Ancient': '#eb4b4b', 'Immortal': '#e4ae39' };
    for (const [k, v] of Object.entries(map))
        if (r.toLowerCase().includes(k.toLowerCase())) return v;
    return '#546e7a';
}

