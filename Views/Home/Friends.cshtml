<script>
const connection = new signalR.HubConnectionBuilder()
    .withUrl('/calculationHub')
    .withAutomaticReconnect({
        nextRetryDelayInMilliseconds: ctx => {
            const delays = [1000, 3000, 10000, 30000, 60000];
            return delays[ctx.previousRetryCount] ?? 60000;
        }
    })
    .build();

let currentSteamId = null;
let currentFriendId = null;
let myProfileUrl = '';
let allFriends = [];
let gamesData = [];
let inventoryData = {};
let currentInvApp = 730;
let gamesSortKey = 'playtime';

// ── SignalR handlers ───────────────────────────────────────────────────────
connection.on('ReceiveFriends', friends => {
    allFriends = friends;
    document.getElementById('friendCount').textContent = `${friends.length} amigos`;
    renderFriendsList(friends);
});

connection.on('ReceiveFriendDetails', d => {
    hideProfileLoading();
    renderFriendProfile(d);
});

connection.on('ReceiveFriendGames', (steamId, games) => {
    gamesData = games;
    renderGames(games);
    hideProfileLoading();
});

connection.on('ReceiveFriendInventory', (steamId, appId, items, total) => {
    inventoryData[appId] = { items, total };
    renderInventory(appId, items, total);
    // Wire up wear filter checkboxes for re-render
    ['fWearFN','fWearMW','fWearFT','fWearWW','fWearBS'].forEach(id => {
        const el = document.getElementById(id);
        if (el && !el._wired) { el._wired = true; el.addEventListener('change', () => { if (inventoryData[appId]) renderInventory(appId, inventoryData[appId].items, inventoryData[appId].total); }); }
    });
    hideProfileLoading();
});

connection.on('ReceiveBadgesAndLevel', data => {
    renderBadgesTab(data);
    hideProfileLoading();
});

connection.on('ReceiveAchievements', (appId, total, unlocked, pct, list) => {
    renderAchievements(appId, total, unlocked, pct, list);
    hideProfileLoading();
});

connection.on('ReceiveGamerDna', dna => {
    renderDna(dna);
    hideProfileLoading();
});

connection.on('ReceiveWishlistAnalysis', data => {
    renderWishlistAnalysis(data);
    hideProfileLoading();
});

connection.on('ReceiveFriendActivityPatterns', patterns => {
    renderActivityPatterns(patterns);
    hideProfileLoading();
});

connection.on('ReceiveProfileComparison', data => {
    renderComparison(data);
    document.getElementById('profileLoading').style.display = 'none';
});

connection.on('ReceiveError', msg => {
    hideProfileLoading();
    showErr(msg);
});

// ── Helpers ────────────────────────────────────────────────────────────────
function showErr(msg) {
    const b = document.getElementById('errBox');
    b.textContent = '❌ ' + msg;
    b.style.display = 'block';
    setTimeout(() => b.style.display = 'none', 6000);
}

function showProfileLoading(text) {
    document.getElementById('profileLoading').style.display = 'flex';
    document.getElementById('profileLoadingText').textContent = text || 'Carregando...';
}

function hideProfileLoading() {
    document.getElementById('profileLoading').style.display = 'none';
}

function fmtHours(min) {
    const h = min / 60;
    return h < 1 ? `${min}m` : h < 100 ? `${h.toFixed(1)}h` : `${Math.round(h)}h`;
}

function fmtBRL(val) {
    return val > 0 ? `R$ ${val.toFixed(2)}` : 'Grátis';
}

function stateLabel(s) {
    const m = { 0: ['Offline','badge-offline'], 1: ['Online','badge-online'], 2: ['Ocupado','badge-offline'],
                 3: ['Ausente','badge-offline'], 4: ['Soneca','badge-offline'], 5: ['Quer jogar','badge-online'],
                 6: ['Quer trocar','badge-online'] };
    return m[s] || ['Offline','badge-offline'];
}

function countryFlag(code) {
    if (!code) return '';
    return code.toUpperCase().replace(/./g, c => String.fromCodePoint(c.charCodeAt(0) + 127397));
}

// ── Load friends ───────────────────────────────────────────────────────────
async function loadFriends() {
    const url = document.getElementById('urlInput').value.trim();
    if (!url) return;
    myProfileUrl = url;
    document.getElementById('friendsList').innerHTML = '<div class="friends-loading"><div class="spinner"></div><div style="margin-top:8px;font-size:.82rem;color:var(--text3)">Carregando amigos...</div></div>';
    document.getElementById('emptyState').style.display = 'flex';
    document.getElementById('friendProfile').style.display = 'none';
    await connection.invoke('GetFriends', url);
}

// ── Render friends list ────────────────────────────────────────────────────
function renderFriendsList(friends) {
    const container = document.getElementById('friendsList');
    if (!friends || friends.length === 0) {
        container.innerHTML = '<div class="friends-loading"><div style="opacity:.4">😶</div><div style="color:var(--text3);font-size:.83rem;margin-top:8px">Nenhum amigo encontrado</div></div>';
        return;
    }
    container.innerHTML = friends.map(f => {
        const dotClass = f.gameExtra ? 'status-ingame' : (f.isOnline ? 'status-online' : 'status-offline');
        const sub = f.gameExtra ? `🎮 ${f.gameExtra}` : (f.isOnline ? 'Online' : 'Offline');
        const av = f.avatar || 'https://avatars.cloudflare.steamstatic.com/fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb_full.jpg';
        return `<div class="friend-item" data-id="${f.id}" onclick="selectFriend('${f.id}','${escHtml(f.name||f.id)}')">
            <div class="friend-avatar-wrap">
                <img class="friend-avatar" src="${av}" alt="" loading="lazy" onerror="this.src='https://avatars.cloudflare.steamstatic.com/fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb_full.jpg'">
                <div class="status-dot ${dotClass}"></div>
            </div>
            <div class="friend-info">
                <div class="friend-name">${escHtml(f.name||f.id)}</div>
                <div class="friend-sub">${escHtml(sub)}</div>
            </div>
        </div>`;
    }).join('');
}

function escHtml(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

document.getElementById('filterInput').addEventListener('input', e => {
    const q = e.target.value.toLowerCase();
    const filtered = q ? allFriends.filter(f => (f.name||'').toLowerCase().includes(q)) : allFriends;
    renderFriendsList(filtered);
});

// ── Select Friend ──────────────────────────────────────────────────────────
async function selectFriend(steamId, name) {
    if (currentFriendId === steamId) return;
    currentFriendId = steamId;

    // Highlight selected
    document.querySelectorAll('.friend-item').forEach(el => el.classList.remove('active'));
    const el = document.querySelector(`.friend-item[data-id="${steamId}"]`);
    if (el) el.classList.add('active');

    // Reset UI
    document.getElementById('emptyState').style.display = 'none';
    document.getElementById('friendProfile').style.display = 'block';
    gamesData = [];
    inventoryData = {};
    document.getElementById('fp-name').textContent = name;
    document.getElementById('fp-avatar').src = '';
    document.getElementById('fp-badges').innerHTML = '';
    document.getElementById('st-level').textContent = '—';
    document.getElementById('st-games').textContent = '—';
    document.getElementById('st-badges').textContent = '—';
    document.getElementById('st-xp').textContent = '—';
    document.getElementById('st-wishlist').textContent = '—';
    document.getElementById('st-groups').textContent = '—';
    document.getElementById('st-gvalue').textContent = '—';
    document.getElementById('games-grid').innerHTML = '<div class="text-muted text-center" style="grid-column:1/-1;padding:30px">Clique em "🎮 Jogos" para carregar a biblioteca</div>';
    document.getElementById('inv-grid').innerHTML = '<div class="text-muted text-center" style="grid-column:1/-1;padding:30px">Selecione um jogo acima para ver o inventário</div>';
    document.getElementById('inv-tabs').innerHTML = '';
    document.getElementById('inv-total').textContent = '—';
    document.getElementById('friendInvLoadingMsg').style.display = 'none';
    document.getElementById('friendCs2WearFilters').style.display = 'none';
    // Reset inv game buttons if they exist
    const invGameBtns = document.getElementById('friendInvGameBtns');
    if (invGameBtns) invGameBtns.innerHTML = '';
    document.getElementById('badges-grid').innerHTML = '';
    document.getElementById('ach-list').innerHTML = '';
    document.getElementById('ach-game-btns').innerHTML = '';
    document.getElementById('dna-content').innerHTML = '<div class="text-muted text-center" style="padding:30px">Clique em "🧬 DNA" para analisar o perfil</div>';
    document.getElementById('wishlist-content').innerHTML = '<div class="text-muted text-center" style="padding:30px">Carregando...</div>';
    document.getElementById('activity-content').innerHTML = '<div class="text-muted text-center" style="padding:30px">Carregando padrões de atividade...</div>';
    document.getElementById('compare-result').innerHTML = '';
    document.getElementById('recent-list').innerHTML = '';

    // Switch to recent tab
    switchTab('recent');

    showProfileLoading('Carregando perfil...');
    await connection.invoke('ComputeFriendDetails', steamId);
}

// ── Render Friend Profile ─────────────────────────────────────────────────
function renderFriendProfile(d) {
    document.getElementById('fp-name').textContent = d.name || d.steamId;
    document.getElementById('fp-realname').textContent = d.realName ? `"${d.realName}"` : '';
    document.getElementById('fp-avatar').src = d.avatar || '';
    document.getElementById('fp-steam-link').href = d.profileUrl || `https://steamcommunity.com/profiles/${d.steamId}`;

    // State badge
    const [stateTxt, stateClass] = stateLabel(d.personastate);
    let badgesHtml = `<span class="profile-badge ${stateClass}">${stateTxt}</span>`;
    badgesHtml += `<span class="profile-badge badge-level">Nível ${d.level}</span>`;
    if (d.country) badgesHtml += `<span class="profile-badge badge-country">${countryFlag(d.country)} ${d.country}</span>`;
    if (d.bans) {
        if (d.bans.vacBanned || d.bans.numberOfVacBans > 0)
            badgesHtml += `<span class="profile-badge badge-vac">⚠️ VAC BAN</span>`;
        else
            badgesHtml += `<span class="profile-badge badge-clean">✅ Sem Bans</span>`;
        if (d.bans.numberOfGameBans > 0)
            badgesHtml += `<span class="profile-badge badge-vac">${d.bans.numberOfGameBans} Game Ban(s)</span>`;
    }
    document.getElementById('fp-badges').innerHTML = badgesHtml;

    // Stats
    document.getElementById('st-level').textContent = d.level || 0;
    document.getElementById('st-games').textContent = d.gamesCount || 0;
    document.getElementById('st-badges').textContent = d.badgeCount || 0;
    document.getElementById('st-xp').textContent = d.totalXp ? d.totalXp.toLocaleString() : 0;
    document.getElementById('st-wishlist').textContent = d.wishlistCount || 0;
    document.getElementById('st-groups').textContent = d.groupCount || 0;
    document.getElementById('st-gvalue').textContent = d.gamesValue ? `R$${d.gamesValue.toFixed(0)}` : '—';

    // Recent games
    const recentContainer = document.getElementById('recent-list');
    if (d.recentGames && d.recentGames.length > 0) {
        recentContainer.innerHTML = d.recentGames.map(g => `
            <div class="recent-item">
                <img class="recent-thumb" src="${g.imageUrl}" alt="${escHtml(g.name)}" onerror="this.src='https://via.placeholder.com/56x32/111d2e/4a6480?text=N/A'">
                <div class="recent-info">
                    <div class="recent-name">${escHtml(g.name)}</div>
                    <div class="recent-time">Total: ${fmtHours(g.playtimeForever)}</div>
                </div>
                <div class="recent-hours">${fmtHours(g.playtime2weeks)} / 2 sem</div>
                <button class="btn btn-ghost btn-xs" onclick="loadAchievements(${g.appId},'${escHtml(g.name)}')">🏆</button>
            </div>
        `).join('');
    } else {
        recentContainer.innerHTML = '<div class="text-muted text-center" style="padding:20px">Perfil privado ou sem atividade recente</div>';
    }

    // Auto-load badges and wishlist
    loadBadgesTab();
    loadWishlistAnalysis();
    loadActivityPatterns();
}

// ── Tabs ───────────────────────────────────────────────────────────────────
function switchTab(name) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.toggle('active', b.dataset.tab === name));
    document.querySelectorAll('.tab-content').forEach(c => c.classList.toggle('active', c.id === 'tab-' + name));
}

document.querySelectorAll('.tab-btn').forEach(b => {
    b.addEventListener('click', () => switchTab(b.dataset.tab));
});

// ── Games ─────────────────────────────────────────────────────────────────
document.getElementById('btn-load-games').addEventListener('click', () => {
    if (!currentFriendId) return;
    showProfileLoading('Carregando biblioteca...');
    switchTab('games');
    connection.invoke('GetFriendGames', currentFriendId);
});

document.getElementById('games-search').addEventListener('input', e => {
    const q = e.target.value.toLowerCase();
    document.querySelectorAll('.game-card').forEach(card => {
        const name = card.querySelector('.game-card-name').textContent.toLowerCase();
        card.style.display = name.includes(q) ? '' : 'none';
    });
});

document.querySelectorAll('.sort-btn').forEach(btn => {
    btn.addEventListener('click', () => {
        document.querySelectorAll('.sort-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        gamesSortKey = btn.dataset.sort;
        if (gamesData.length) renderGames(gamesData);
    });
});

function renderGames(games) {
    const sorted = [...games].sort((a, b) => {
        if (gamesSortKey === 'playtime') return b.playtimeMinutes - a.playtimeMinutes;
        if (gamesSortKey === 'price') return b.price - a.price;
        if (gamesSortKey === 'metacritic') return b.metacritic - a.metacritic;
        return a.name.localeCompare(b.name);
    });
    const container = document.getElementById('games-grid');
    if (!sorted.length) {
        container.innerHTML = '<div class="text-muted text-center" style="grid-column:1/-1;padding:30px">Nenhum jogo encontrado</div>';
        return;
    }
    container.innerHTML = sorted.map(g => {
        const priceHtml = g.price > 0
            ? `<span class="game-price-tag price-paid">R$${g.price.toFixed(2)}</span>`
            : `<span class="game-price-tag price-free">Grátis</span>`;
        return `<div class="game-card" onclick="loadAchievements(${g.appId},'${escHtml(g.name)}')">
            <img class="game-thumb" src="${g.imageUrl}" alt="${escHtml(g.name)}" loading="lazy" onerror="this.src='https://via.placeholder.com/160x80/111d2e/4a6480?text=N/A'">
            <div class="game-card-body">
                <div class="game-card-name" title="${escHtml(g.name)}">${escHtml(g.name)}</div>
                <div class="game-card-meta">${fmtHours(g.playtimeMinutes)} • ${g.metacritic ? '⭐'+g.metacritic : g.genre || ''}</div>
                ${priceHtml}
            </div>
        </div>`;
    }).join('');
}

