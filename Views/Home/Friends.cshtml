@model CalculateViewModel
@{
    ViewData["Title"] = "SteamValue – Amigos";
    Layout = null;
    string initUrl = ViewData["ProfileUrl"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SteamValue – Amigos</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Exo+2:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@latest/dist/browser/signalr.min.js"></script>
    <style>
        :root {
            --bg:#060b14; --bg1:#0d1524; --bg2:#111d2e; --bg3:#162236;
            --border:#1a3050; --border2:#243f5e;
            --cyan:#00e5ff; --cyan2:#00b8d9; --orange:#ff5722; --orange2:#e64a19;
            --gold:#ffd740; --green:#00e676; --red:#ff1744; --purple:#e040fb; --blue:#448aff;
            --text:#cdd9e5; --text2:#8fadc8; --text3:#4a6480;
            --online:#00e676; --offline:#546e7a; --ingame:#69ff47;
        }
        *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
        body{font-family:'Exo 2',sans-serif;background:var(--bg);color:var(--text);min-height:100vh}
        body::before{content:'';position:fixed;inset:0;z-index:0;pointer-events:none;
            background:radial-gradient(ellipse 60% 40% at 15% 30%,rgba(0,229,255,.05) 0%,transparent 70%),
            radial-gradient(ellipse 50% 50% at 85% 70%,rgba(255,87,34,.05) 0%,transparent 70%),
            repeating-linear-gradient(0deg,transparent,transparent 59px,rgba(255,255,255,.01) 60px),
            repeating-linear-gradient(90deg,transparent,transparent 59px,rgba(255,255,255,.01) 60px)}

        /* NAV */
        .nav{display:flex;align-items:center;justify-content:space-between;padding:0 32px;height:58px;
            background:rgba(6,11,20,.95);border-bottom:1px solid var(--border);
            backdrop-filter:blur(20px);position:sticky;top:0;z-index:300}
        .nav-brand{font-family:'Orbitron',sans-serif;font-size:1.15rem;font-weight:900;
            background:linear-gradient(90deg,var(--cyan),var(--orange));
            -webkit-background-clip:text;-webkit-text-fill-color:transparent;letter-spacing:2px}
        .nav-links{display:flex;gap:4px}
        .nav-link{padding:6px 14px;border-radius:6px;color:var(--text2);text-decoration:none;
            font-size:.87rem;font-weight:500;transition:all .2s;border:1px solid transparent}
        .nav-link:hover,.nav-link.active{color:var(--cyan);border-color:rgba(0,229,255,.25);background:rgba(0,229,255,.06)}

        .page{max-width:1600px;margin:0 auto;padding:20px 16px;position:relative;z-index:1}

        /* SEARCH BAR */
        .search-bar{background:var(--bg1);border:1px solid var(--border);border-radius:14px;padding:18px 22px;margin-bottom:16px;display:flex;gap:10px;flex-wrap:wrap;align-items:center}
        .url-input{flex:1;min-width:260px;padding:11px 15px;background:rgba(0,0,0,.4);
            border:1.5px solid var(--border);border-radius:10px;color:#fff;font-size:.93rem;font-family:'Exo 2',sans-serif;transition:border-color .25s,box-shadow .25s}
        .url-input:focus{outline:none;border-color:var(--cyan);box-shadow:0 0 0 3px rgba(0,229,255,.1)}
        .url-input::placeholder{color:var(--text3)}
        .btn{display:inline-flex;align-items:center;gap:6px;padding:10px 16px;border:none;border-radius:10px;
            font-family:'Exo 2',sans-serif;font-size:.88rem;font-weight:700;cursor:pointer;transition:all .2s;white-space:nowrap}
        .btn-cyan{background:linear-gradient(135deg,var(--cyan),var(--cyan2));color:#000}
        .btn-cyan:hover{filter:brightness(1.1);transform:translateY(-1px)}
        .btn-orange{background:linear-gradient(135deg,var(--orange),var(--orange2));color:#fff;box-shadow:0 4px 12px rgba(255,87,34,.2)}
        .btn-orange:hover{filter:brightness(1.1);transform:translateY(-1px)}
        .btn-ghost{background:rgba(255,255,255,.04);color:var(--text2);border:1px solid var(--border)}
        .btn-ghost:hover{background:rgba(255,255,255,.08);color:var(--text)}
        .btn-green{background:linear-gradient(135deg,var(--green),#00c853);color:#000}
        .btn-sm{padding:6px 12px;font-size:.8rem}
        .btn-xs{padding:4px 9px;font-size:.75rem}
        .btn:disabled{opacity:.4;pointer-events:none}

        /* MAIN LAYOUT */
        .main{display:grid;grid-template-columns:300px 1fr;gap:16px;align-items:start}
        @@media (max-width:1024px){.main{grid-template-columns:1fr}}

        /* FRIENDS LIST PANEL */
        .friends-panel{background:var(--bg1);border:1px solid var(--border);border-radius:14px;overflow:hidden;height:calc(100vh - 160px);display:flex;flex-direction:column;position:sticky;top:74px}
        .panel-header{padding:14px 16px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;flex-shrink:0}
        .panel-title{font-family:'Orbitron',sans-serif;font-size:.9rem;font-weight:700;color:#fff;letter-spacing:.5px}
        .panel-filter{padding:10px 14px;border-bottom:1px solid var(--border);flex-shrink:0}
        .filter-input{width:100%;padding:7px 11px;background:rgba(0,0,0,.4);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:.83rem;font-family:'Exo 2',sans-serif}
        .filter-input:focus{outline:none;border-color:var(--cyan)}
        .friends-list{overflow-y:auto;flex:1;padding:8px}
        .friends-list::-webkit-scrollbar{width:4px}
        .friends-list::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px}
        .friend-item{display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:10px;cursor:pointer;transition:all .2s;border:1px solid transparent;margin-bottom:3px}
        .friend-item:hover{background:rgba(0,229,255,.05);border-color:rgba(0,229,255,.15)}
        .friend-item.active{background:rgba(0,229,255,.1);border-color:rgba(0,229,255,.3)}
        .friend-avatar-wrap{position:relative;flex-shrink:0}
        .friend-avatar{width:38px;height:38px;border-radius:6px;object-fit:cover;background:var(--bg3)}
        .status-dot{position:absolute;bottom:-2px;right:-2px;width:11px;height:11px;border-radius:50%;border:2px solid var(--bg1)}
        .status-online{background:var(--online)}
        .status-offline{background:var(--offline)}
        .status-ingame{background:var(--ingame)}
        .friend-info{flex:1;min-width:0}
        .friend-name{font-size:.83rem;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
        .friend-sub{font-size:.72rem;color:var(--text3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
        .friends-loading{text-align:center;padding:40px;color:var(--text3)}
        .spinner{display:inline-block;width:20px;height:20px;border:2px solid rgba(0,229,255,.2);border-top-color:var(--cyan);border-radius:50%;animation:spin .7s linear infinite}
        @@keyframes spin{to{transform:rotate(360deg)}}

        /* PROFILE PANEL (right side) */
        .profile-panel{background:var(--bg1);border:1px solid var(--border);border-radius:14px;overflow:hidden}
        .empty-state{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:80px 40px;gap:16px;text-align:center}
        .empty-icon{font-size:3rem;opacity:.4}
        .empty-title{font-size:1.1rem;color:var(--text2);font-family:'Orbitron',sans-serif;font-weight:700}
        .empty-sub{font-size:.85rem;color:var(--text3)}

        /* FRIEND PROFILE HEADER */
        .friend-profile-header{position:relative;overflow:hidden}
        .profile-bg{position:absolute;inset:0;background:linear-gradient(135deg,rgba(0,229,255,.05),rgba(255,87,34,.05));z-index:0}
        .profile-hero{position:relative;z-index:1;padding:24px;display:flex;gap:20px;align-items:flex-start}
        .profile-avatar-lg{width:80px;height:80px;border-radius:10px;border:3px solid var(--border2);object-fit:cover}
        .profile-main-info{flex:1}
        .profile-name{font-family:'Orbitron',sans-serif;font-size:1.4rem;font-weight:900;color:#fff;margin-bottom:4px}
        .profile-realname{font-size:.83rem;color:var(--text3);margin-bottom:8px}
        .profile-badges-row{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px}
        .profile-badge{padding:3px 10px;border-radius:20px;font-size:.72rem;font-weight:700;letter-spacing:.5px}
        .badge-level{background:rgba(255,215,64,.15);color:var(--gold);border:1px solid rgba(255,215,64,.3)}
        .badge-vac{background:rgba(255,23,68,.15);color:var(--red);border:1px solid rgba(255,23,68,.3)}
        .badge-clean{background:rgba(0,230,118,.15);color:var(--green);border:1px solid rgba(0,230,118,.3)}
        .badge-country{background:rgba(68,138,255,.15);color:var(--blue);border:1px solid rgba(68,138,255,.3)}
        .badge-online{background:rgba(0,230,118,.15);color:var(--online);border:1px solid rgba(0,230,118,.3)}
        .badge-ingame{background:rgba(105,255,71,.15);color:var(--ingame);border:1px solid rgba(105,255,71,.3)}
        .badge-offline{background:rgba(84,110,122,.15);color:var(--text3);border:1px solid rgba(84,110,122,.3)}
        .profile-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}

        /* STATS ROW */
        .stats-row{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:1px;background:var(--border);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
        .stat-cell{background:var(--bg1);padding:14px 16px;text-align:center}
        .stat-val{font-family:'Orbitron',sans-serif;font-size:1.1rem;font-weight:700;color:var(--cyan)}
        .stat-label{font-size:.7rem;color:var(--text3);text-transform:uppercase;letter-spacing:.7px;margin-top:2px}

        /* TABS */
        .tabs-bar{display:flex;gap:2px;padding:10px 16px;background:var(--bg2);border-bottom:1px solid var(--border);overflow-x:auto;flex-wrap:nowrap}
        .tabs-bar::-webkit-scrollbar{height:3px}
        .tabs-bar::-webkit-scrollbar-thumb{background:var(--border2)}
        .tab-btn{padding:7px 14px;border-radius:8px;border:none;background:transparent;color:var(--text3);font-family:'Exo 2',sans-serif;font-size:.82rem;font-weight:600;cursor:pointer;transition:all .2s;white-space:nowrap;flex-shrink:0}
        .tab-btn:hover{color:var(--text);background:rgba(255,255,255,.05)}
        .tab-btn.active{color:#fff;background:rgba(0,229,255,.15);border:1px solid rgba(0,229,255,.3)}

        /* TAB CONTENT */
        .tab-content{display:none;padding:16px}
        .tab-content.active{display:block}

        /* GAMES TABLE */
        .games-search{width:100%;padding:8px 12px;background:rgba(0,0,0,.4);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:'Exo 2',sans-serif;font-size:.85rem;margin-bottom:12px}
        .games-search:focus{outline:none;border-color:var(--cyan)}
        .games-controls{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;align-items:center}
        .sort-btn{padding:5px 12px;border-radius:6px;border:1px solid var(--border);background:rgba(0,0,0,.3);color:var(--text2);font-size:.77rem;cursor:pointer;font-family:'Exo 2',sans-serif;transition:all .2s}
        .sort-btn.active{border-color:var(--cyan);color:var(--cyan);background:rgba(0,229,255,.08)}
        .games-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:10px;max-height:520px;overflow-y:auto}
        .games-grid::-webkit-scrollbar{width:4px}
        .games-grid::-webkit-scrollbar-thumb{background:var(--border2)}
        .game-card{background:var(--bg2);border:1px solid var(--border);border-radius:10px;overflow:hidden;cursor:pointer;transition:all .2s}
        .game-card:hover{border-color:var(--cyan);transform:translateY(-2px);box-shadow:0 4px 16px rgba(0,229,255,.1)}
        .game-thumb{width:100%;height:80px;object-fit:cover;background:var(--bg3)}
        .game-card-body{padding:8px}
        .game-card-name{font-size:.75rem;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:4px}
        .game-card-meta{font-size:.68rem;color:var(--text3)}
        .game-price-tag{display:inline-block;padding:2px 6px;border-radius:4px;font-size:.7rem;font-weight:700;margin-top:4px}
        .price-paid{background:rgba(0,229,255,.1);color:var(--cyan)}
        .price-free{background:rgba(0,230,118,.1);color:var(--green)}

        /* INVENTORY */
        .inv-tabs{display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap}
        .inv-tab{padding:6px 14px;border-radius:8px;border:1px solid var(--border);background:transparent;color:var(--text3);font-size:.8rem;cursor:pointer;font-family:'Exo 2',sans-serif;transition:all .2s}
        .inv-tab.active{border-color:var(--orange);color:var(--orange);background:rgba(255,87,34,.08)}
        .friend-inv-game-btn.active{border-color:var(--orange);color:var(--orange);background:rgba(255,87,34,.08)}
        .inv-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:8px;max-height:480px;overflow-y:auto}
        .inv-grid::-webkit-scrollbar{width:4px}
        .inv-grid::-webkit-scrollbar-thumb{background:var(--border2)}
        .inv-card{background:var(--bg2);border:1px solid var(--border);border-radius:8px;overflow:hidden;position:relative}
        .inv-card-img{width:100%;height:75px;object-fit:cover;background:var(--bg3)}
        .inv-card-body{padding:6px}
        .inv-card-name{font-size:.68rem;color:var(--text);margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
        .inv-card-price{font-size:.72rem;font-weight:700;color:var(--green)}
        .inv-card-count{position:absolute;top:4px;right:4px;background:rgba(0,0,0,.8);border-radius:4px;padding:1px 5px;font-size:.67rem;font-weight:700;color:#fff}
        .rarity-badge{position:absolute;top:4px;left:4px;padding:1px 5px;border-radius:3px;font-size:.6rem;font-weight:700}
        .inv-total-bar{background:var(--bg3);border-radius:8px;padding:10px 14px;margin-bottom:12px;display:flex;justify-content:space-between;align-items:center}

        /* BADGES TAB */
        .badges-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(90px,1fr));gap:8px}
        .badge-card{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:10px;text-align:center}
        .badge-card img{width:64px;height:64px;object-fit:contain}
        .badge-card-name{font-size:.65rem;color:var(--text2);margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
        .badge-card-xp{font-size:.7rem;font-weight:700;color:var(--gold)}

        /* RECENT GAMES */
        .recent-list{display:flex;flex-direction:column;gap:8px}
        .recent-item{display:flex;gap:12px;align-items:center;background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:10px 12px}
        .recent-thumb{width:56px;height:32px;border-radius:4px;object-fit:cover}
        .recent-info{flex:1;min-width:0}
        .recent-name{font-size:.85rem;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
        .recent-time{font-size:.75rem;color:var(--text3)}
        .recent-hours{font-size:.8rem;font-weight:700;color:var(--cyan)}

        /* DNA TAB */
        .dna-hero{text-align:center;padding:20px;background:linear-gradient(135deg,rgba(0,229,255,.05),rgba(255,87,34,.05));border-radius:12px;margin-bottom:16px}
        .dna-archetype{font-family:'Orbitron',sans-serif;font-size:1.6rem;font-weight:900;color:var(--cyan);text-shadow:0 0 30px rgba(0,229,255,.4)}
        .dna-score{font-size:3rem;font-weight:900;font-family:'Orbitron',sans-serif;background:linear-gradient(135deg,var(--cyan),var(--orange));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
        .dna-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:10px;margin-bottom:16px}
        .dna-pillar{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:12px;text-align:center}
        .dna-pillar-label{font-size:.72rem;color:var(--text3);text-transform:uppercase;letter-spacing:.6px;margin-bottom:8px}
        .dna-bar-wrap{background:rgba(0,0,0,.4);border-radius:4px;height:8px;margin-bottom:6px}
        .dna-bar{height:8px;border-radius:4px;transition:width .8s ease}
        .dna-pillar-val{font-size:1.1rem;font-weight:700;font-family:'Orbitron',sans-serif}

        /* WISHLIST TAB */
        .wishlist-summary{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:8px;margin-bottom:14px}
        .wish-stat{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:12px;text-align:center}
        .wish-stat-val{font-family:'Orbitron',sans-serif;font-size:1.1rem;font-weight:700;color:var(--gold)}
        .wish-stat-label{font-size:.7rem;color:var(--text3);margin-top:2px}
        .wishlist-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px;max-height:420px;overflow-y:auto}
        .wish-card{background:var(--bg2);border:1px solid var(--border);border-radius:10px;overflow:hidden}
        .wish-card img{width:100%;height:70px;object-fit:cover}
        .wish-card-body{padding:8px}
        .wish-card-name{font-size:.74rem;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:4px}
        .wish-sale-bar{height:4px;border-radius:2px;margin-top:6px}
        .sale-hot{background:var(--red)}
        .sale-warm{background:var(--orange)}
        .sale-cool{background:var(--text3)}

        /* ACTIVITY PATTERNS TAB */
        .slots-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:16px}
        .slot-card{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:14px}
        .slot-title{font-size:.8rem;font-weight:700;color:var(--text);margin-bottom:10px}
        .slot-friends{display:flex;flex-wrap:wrap;gap:4px}
        .slot-avatar{width:28px;height:28px;border-radius:4px;object-fit:cover;cursor:pointer}
        .slot-count{font-family:'Orbitron',sans-serif;font-size:1.3rem;font-weight:700;color:var(--cyan)}

        /* ACHIEVEMENTS TAB */
        .ach-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;flex-wrap:wrap;gap:8px}
        .ach-progress{background:rgba(0,0,0,.4);border-radius:6px;height:10px;flex:1;max-width:300px}
        .ach-fill{height:10px;border-radius:6px;background:linear-gradient(90deg,var(--cyan),var(--orange))}
        .ach-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:8px;max-height:460px;overflow-y:auto}
        .ach-item{display:flex;gap:10px;align-items:center;background:var(--bg2);border:1px solid var(--border);border-radius:8px;padding:8px 10px}
        .ach-item.unlocked{border-color:rgba(0,230,118,.25);background:rgba(0,230,118,.04)}
        .ach-icon{width:40px;height:40px;border-radius:6px;object-fit:cover;flex-shrink:0}
        .ach-info{min-width:0}
        .ach-name{font-size:.8rem;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
        .ach-desc{font-size:.72rem;color:var(--text3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

        /* COMPARISON */
        .compare-grid{display:grid;grid-template-columns:1fr auto 1fr;gap:16px;align-items:center;margin-bottom:16px}
        .compare-stat{text-align:center;background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:14px}
        .compare-vs{font-family:'Orbitron',sans-serif;font-size:1.2rem;font-weight:900;color:var(--text3)}
        .compare-label{font-size:.7rem;color:var(--text3);margin-bottom:6px}
        .compare-val{font-family:'Orbitron',sans-serif;font-size:1.1rem;font-weight:700}
        .val-win{color:var(--green)}
        .val-lose{color:var(--text3)}
        .val-tie{color:var(--gold)}

        /* LOADING OVERLAY */
        .loading-overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(6,11,20,.8);z-index:10;border-radius:14px}
        .loading-box{text-align:center;padding:24px}
        .loading-text{color:var(--text2);font-size:.9rem;margin-top:12px}

        /* ERROR */
        .error-box{background:rgba(255,23,68,.08);border:1px solid rgba(255,23,68,.3);border-radius:10px;padding:12px 16px;color:var(--red);font-size:.85rem;margin:8px 0}

        /* SECTION TITLE */
        .sec-title{font-family:'Orbitron',sans-serif;font-size:.8rem;font-weight:700;color:var(--text2);text-transform:uppercase;letter-spacing:1px;margin-bottom:10px;padding-bottom:6px;border-bottom:1px solid var(--border)}

        /* TAG */
        .tag{display:inline-block;padding:2px 8px;border-radius:4px;font-size:.7rem;font-weight:600;background:rgba(0,229,255,.1);color:var(--cyan);border:1px solid rgba(0,229,255,.2)}

        .text-center{text-align:center}
        .text-muted{color:var(--text3);font-size:.8rem}
        .mt-8{margin-top:8px}
        .flex{display:flex}
        .gap-8{gap:8px}
        .wrap{flex-wrap:wrap}
        .items-center{align-items:center}
        .between{justify-content:space-between}
    </style>
</head>
<body>
<nav class="nav">
    <span class="nav-brand">STEAMVALUE</span>
    <div class="nav-links">
        <a href="/" class="nav-link">⬡ Início</a>
        <a href="/Home/Friends" class="nav-link active">👥 Amigos</a>
    </div>
</nav>

<div class="page">
    <!-- Search Bar -->
    <div class="search-bar">
        <span style="font-family:'Orbitron',sans-serif;font-size:.95rem;font-weight:700;color:#fff;white-space:nowrap">👥 Mapa de Amigos</span>
