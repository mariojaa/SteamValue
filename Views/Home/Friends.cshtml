                        <div style="display:flex;align-items:center;gap:10px">
                            <div class="ach-progress"><div id="ach-fill" class="ach-fill" style="width:0%"></div></div>
                            <span id="ach-pct" style="font-size:.85rem;font-weight:700;color:var(--cyan)">0%</span>
                        </div>
                    </div>
                    <div style="display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap" id="ach-game-btns"></div>
                    <div id="ach-list" class="ach-list"></div>
                </div>

                <!-- Tab: DNA Gamer -->
                <div class="tab-content" id="tab-dna">
                    <div id="dna-content">
                        <div class="text-muted text-center" style="padding:30px">Clique em "🧬 DNA" para analisar o perfil</div>
                    </div>
                </div>

                <!-- Tab: Wishlist -->
                <div class="tab-content" id="tab-wishlist">
                    <div id="wishlist-content">
                        <div class="text-muted text-center" style="padding:30px">Clique em "💛 Wishlist" na aba para carregar</div>
                    </div>
                </div>

                <!-- Tab: Atividade (Sleep Schedule) -->
