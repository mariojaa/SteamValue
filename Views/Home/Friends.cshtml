function renderComparison(d) {
    const stats = [
        { label: 'Nível Steam', v1: d.level1, v2: d.level2 },
        { label: 'Jogos', v1: d.gamesCount1, v2: d.gamesCount2 },
        { label: 'Horas Totais', v1: d.totalHours1, v2: d.totalHours2, suffix: 'h' },
        { label: 'Medalhas', v1: d.badgeCount1, v2: d.badgeCount2 },
        { label: 'XP Total', v1: d.totalXp1, v2: d.totalXp2 }
    ];
    const container = document.getElementById('compare-result');
    container.innerHTML = `
        <div style="display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:center;text-align:center;margin-bottom:14px">
            <div style="font-weight:700;color:var(--cyan)">${escHtml(d.name1 || 'Amigo')}</div>
            <div style="font-family:'Orbitron',sans-serif;color:var(--text3);font-size:.9rem">VS</div>
            <div style="font-weight:700;color:var(--orange)">${escHtml(d.name2 || 'Você')}</div>
        </div>
        ${stats.map(s => {
            const suffix = s.suffix || '';
            const win1 = s.v1 > s.v2 ? 'val-win' : s.v1 < s.v2 ? 'val-lose' : 'val-tie';
            const win2 = s.v2 > s.v1 ? 'val-win' : s.v2 < s.v1 ? 'val-lose' : 'val-tie';
            return `<div style="display:grid;grid-template-columns:1fr auto 1fr;gap:8px;align-items:center;margin-bottom:8px;background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:10px 14px">
                <div class="compare-val ${win1}" style="text-align:left">${s.v1.toLocaleString()}${suffix}</div>
                <div style="font-size:.72rem;color:var(--text3);text-align:center;min-width:80px">${s.label}</div>
                <div class="compare-val ${win2}" style="text-align:right">${s.v2.toLocaleString()}${suffix}</div>
            </div>`;
        }).join('')}
        ${d.commonGamesCount > 0 ? `<div class="sec-title" style="margin-top:12px">🎮 ${d.commonGamesCount} Jogos em Comum</div>
        <div style="display:flex;flex-wrap:wrap;gap:6px">
            ${(d.commonGames||[]).slice(0,12).map(g => `
                <div style="display:flex;align-items:center;gap:6px;background:var(--bg2);border:1px solid var(--border);border-radius:6px;padding:4px 8px">
                    <img src="${g.imageUrl||''}" style="width:30px;height:17px;border-radius:2px;object-fit:cover">
                    <span style="font-size:.73rem">${escHtml(g.name)}</span>
                </div>
            `).join('')}
        </div>` : ''}
    `;
}

// ── Tab handler for lazy-load tabs ────────────────────────────────────────
document.querySelectorAll('.tab-btn').forEach(b => {
    b.addEventListener('click', () => {
        const tab = b.dataset.tab;
        if (tab === 'wishlist' && currentFriendId) {
            // already loaded on friend select
        }
        if (tab === 'dna' && currentFriendId) {
            if (document.getElementById('dna-content').querySelector('.text-muted')) loadDna();
        }
    });
});

// ── Start connection — com reconexão automática ────────────────────────────
async function startConnection() {
    try {
        await connection.start();
        console.log('[SignalR] Conectado.');
        document.getElementById('errBox').style.display = 'none';
        if ('@initUrl' && '@initUrl' !== '') {
            loadFriends();
        }
    } catch (err) {
        console.error('[SignalR] Falha ao conectar:', err);
        document.getElementById('errBox').textContent = '⚠ Conectando ao servidor... Tentando novamente em 5s.';
        document.getElementById('errBox').style.display = 'block';
        setTimeout(startConnection, 5000);
    }
}

connection.onreconnecting(() => {
    document.getElementById('errBox').textContent = '⟳ Reconectando ao servidor...';
    document.getElementById('errBox').style.display = 'block';
});

connection.onreconnected(() => {
    document.getElementById('errBox').style.display = 'none';
});

connection.onclose(() => {
    document.getElementById('errBox').textContent = '✗ Conexão perdida. Recarregue a página.';
    document.getElementById('errBox').style.display = 'block';
});

startConnection();

document.getElementById('loadBtn').addEventListener('click', loadFriends);
document.getElementById('urlInput').addEventListener('keydown', e => { if (e.key === 'Enter') loadFriends(); });
</script>
</body>
</html>
